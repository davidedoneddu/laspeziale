---
interface Props {
  title: string;
  text?: string;
}

const { title, text } = Astro.props;
---

<div class="section-title">
  <h2>{title}</h2>
  {text && <p>{text}</p>}
</div>

<style>
  .section-title {
    max-width: 760px;
    margin-bottom: 34px;
  }

  .section-title p {
    max-width: 680px;
    font-size: 1.05rem;
  }
</style>
