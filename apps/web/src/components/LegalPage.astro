---
interface Props {
  title: string;
  intro: string;
  updatedAt: string;
}

const { title, intro, updatedAt } = Astro.props;
---

<section class="legal-hero">
  <div class="container legal-hero-inner">
    <h1>{title}</h1>
    <p class="lead">{intro}</p>
    <p class="legal-updated">Ultimo aggiornamento: {updatedAt}</p>
  </div>
</section>

<section class="legal-section">
  <article class="container legal-content">
    <slot />
  </article>
</section>

<style>
  .legal-hero { border-bottom:1px solid rgba(38,51,44,.08); background:var(--color-white); padding:64px 0 40px; }
  .legal-hero-inner { max-width:900px; }
  .legal-hero h1 { margin-bottom:20px; font-size:clamp(2.1rem,5vw,3.6rem); }
  .legal-updated { margin:24px 0 0; font-size:.9rem; font-weight:750; }
  .legal-section { padding:56px 0 64px; }
  .legal-content { max-width:860px; }
  .legal-content :global(section) { border-top:1px solid rgba(38,51,44,.1); padding:32px 0; }
  .legal-content :global(section:first-child) { border-top:0; padding-top:0; }
  .legal-content :global(h2) { margin-bottom:14px; font-family:inherit; font-size:clamp(1.35rem,3vw,1.75rem); font-weight:850; }
  .legal-content :global(h3) { margin:24px 0 8px; }
  .legal-content :global(p), .legal-content :global(li) { max-width:76ch; }
  .legal-content :global(ul) { display:grid; gap:9px; padding-left:22px; color:var(--color-muted); }
  .legal-content :global(a) { color:var(--color-sage-dark); font-weight:750; text-decoration:underline; text-underline-offset:3px; }
  .legal-content :global(.legal-note) { border-left:4px solid var(--color-sage); background:var(--color-white); padding:18px 20px; }
  .legal-content :global(.legal-table) { overflow-x:auto; }
  .legal-content :global(table) { width:100%; border-collapse:collapse; background:var(--color-white); }
  .legal-content :global(th), .legal-content :global(td) { border-bottom:1px solid rgba(38,51,44,.1); padding:14px; text-align:left; vertical-align:top; }
  .legal-content :global(th) { color:var(--color-ink); font-size:.86rem; }
  .legal-content :global(td) { color:var(--color-muted); font-size:.92rem; }
  @media (max-width:640px) { .legal-hero { padding:48px 0 32px; } .legal-section { padding:40px 0 48px; } .legal-content :global(th), .legal-content :global(td) { min-width:150px; padding:12px; } }
</style>
