---
import { getSiteSettings } from "../lib/sanity";

const settings = await getSiteSettings();
const clinicalLinks = [
  { href: "/programmi/gestione-peso-ricomposizione-corporea", label: "Gestione del peso, cellulite e ricomposizione corporea" },
  { href: "/programmi/gonfiore-disturbi-intestinali", label: "Gonfiore e disturbi intestinali" },
  { href: "/programmi/menopausa-premenopausa", label: "Salute femminile e cambiamenti ormonali" },
  { href: "/programmi/programma-anti-age", label: "Longevita e Anti-Age" },
  { href: "/programmi/nutrizione-sportiva", label: "Nutrizione Sportiva" },
];
const consultationLinks = [
  { href: "/fitoterapia", label: "Farmacista Fitoterapeuta" },
  { href: "/consapevolezza", label: "Tutor del Benessere" },
];
const instagramUrl = settings.instagram && settings.instagram !== "https://www.instagram.com/" ? settings.instagram : "https://www.instagram.com/laspezialemilano/";
const facebookUrl = settings.facebook && settings.facebook !== "https://www.facebook.com/" ? settings.facebook : "https://www.facebook.com/laspeziale.it/";
const socialLinks = [
  { href: instagramUrl, label: "Instagram", icon: "instagram" },
  { href: facebookUrl, label: "Facebook", icon: "facebook" },
].filter((link) => Boolean(link.href));
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <a class="footer-brand" href="/">
        <img class="footer-logo" src="/assets/old-site/logo-la-speziale-pellini.png" alt="La Speziale dottoresse Pellini" loading="lazy" decoding="async" />
      </a>
      <p>{settings.footerText || "Nutrizione integrata e percorsi personalizzati a Milano."}</p>
    </div>
    <div>
      <h2>Link rapidi</h2>
      <nav>
        <a href="/il-metodo">Il Metodo</a>
        <a href="/altre-consulenze">Consulenze</a>
        <a href="/dicono-di-noi">Dicono di noi</a>
        <a href="/contatti">Contatti</a>
      </nav>
    </div>
    <div>
      <h2>Aree di intervento</h2>
      <nav>
        {clinicalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
    <div>
      <h2>Consulenze</h2>
      <nav>
        <a href="/altre-consulenze">Panoramica consulenze</a>
        {consultationLinks.map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </div>
    <div>
      <h2>Contatti</h2>
      <p>
        <a href={`tel:${settings.phone.replaceAll(" ", "")}`}>{settings.phone}</a><br />
        <a href={`mailto:${settings.email}`}>{settings.email}</a><br />
        {settings.address}
      </p>
      <div class="social-links" aria-label="Social La Speziale">
        {socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`La Speziale su ${link.label}`}>
            {link.icon === "instagram" ? (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="4" y="4" width="16" height="16" rx="5" />
                <circle cx="12" cy="12" r="3.6" />
                <circle class="icon-dot" cx="16.7" cy="7.3" r="0.8" />
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14.2 8.2h2.1V4.8h-2.8c-3.1 0-4.8 1.9-4.8 4.9v2H6v3.6h2.7V21h3.8v-5.7h3.1l0.5-3.6h-3.6V10c0-1.1 0.5-1.8 1.7-1.8Z" />
              </svg>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>&copy; {new Date().getFullYear()} {settings.siteTitle || "La Speziale"}</span>
    <span class="legal-links">
      <a href={settings.privacyPolicyLink || "/privacy-policy"}>Privacy</a>
      <a href={settings.cookiePolicyLink || "/cookie-policy"}>Cookie</a>
      <button type="button" data-open-cookie-settings>Preferenze cookie</button>
    </span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(19, 56, 43, 0.08);
    background:
      radial-gradient(circle at 12% 0%, rgba(197, 155, 39, 0.1), transparent 28%),
      #e8eadf;
    padding: 54px 0 28px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.75fr 1fr 0.9fr 0.9fr;
    gap: 36px;
  }

  .footer-brand {
    display: inline-block;
    margin-bottom: 14px;
  }

  .footer-brand :global(.footer-logo) {
    width: 240px;
    max-height: 86px;
    object-fit: contain;
  }

  h2 {
    margin-bottom: 12px;
    font-family: inherit;
    font-size: 0.9rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  nav {
    display: grid;
    gap: 8px;
    color: var(--color-muted);
  }

  .social-links {
    display: flex;
    gap: 10px;
    margin-top: 18px;
  }

  .social-links a {
    display: grid;
    width: 38px;
    height: 38px;
    place-items: center;
    border: 1px solid rgba(19, 56, 43, 0.16);
    border-radius: 50%;
    background: rgba(255, 253, 248, 0.58);
    color: var(--color-primary);
    transition: background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .social-links a:hover,
  .social-links a:focus {
    border-color: var(--color-cta);
    background: var(--color-cta);
    color: var(--color-white);
  }

  .social-links svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .social-links .icon-dot {
    fill: currentColor;
    stroke: none;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    border-top: 1px solid rgba(19, 56, 43, 0.08);
    margin-top: 38px;
    padding-top: 22px;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .legal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .legal-links button {
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    font: inherit;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
    }
  }
</style>
