---
import { getSiteSettings } from "../lib/sanity";

interface Props {
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryLink?: string;
  secondaryLabel?: string;
  secondaryLink?: string;
  imageUrl?: string;
  immersive?: boolean;
  titleAsHeading?: boolean;
}

const settings = await getSiteSettings();
const {
  title = "Iniziamo da una consulenza conoscitiva",
  text = "Raccontaci il tuo obiettivo: ti aiuteremo a capire quale percorso nutrizionale e piu adatto al tuo momento.",
  primaryLabel = "Scrivi su WhatsApp",
  primaryLink = settings.whatsapp || "/contatti",
  secondaryLabel = "Invia una email",
  secondaryLink = `mailto:${settings.email}`,
  imageUrl,
  immersive = false,
  titleAsHeading = true,
} = Astro.props;
---

<section class:list={["section", { "immersive-section": immersive }]}>
  <div class:list={["container", "cta", { "cta-image": imageUrl, immersive }]} style={imageUrl ? `--cta-image: url('${imageUrl}')` : undefined}>
    <div>
      {titleAsHeading ? <h2>{title}</h2> : <p class="cta-title">{title}</p>}
      <p>{text}</p>
    </div>
    <div class="button-row">
      <a class="button button-primary" href={primaryLink}>{primaryLabel}</a>
      {secondaryLabel && <a class="button button-secondary" href={secondaryLink}>{secondaryLabel}</a>}
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px;
    align-items: center;
    border-radius: var(--radius);
    background:
      radial-gradient(circle at 10% 15%, rgba(197, 155, 39, 0.18), transparent 34%),
      linear-gradient(135deg, rgba(120, 151, 124, 0.18), rgba(255, 247, 223, 0.72)),
      var(--color-white);
    padding: clamp(24px, 4vw, 40px);
  }

  .immersive-section {
    position: relative;
    overflow: hidden;
    padding: clamp(48px, 5vw, 64px) 0;
    background:
      radial-gradient(circle at 12% 10%, rgba(197, 155, 39, 0.16), transparent 28%),
      linear-gradient(135deg, rgba(120, 151, 124, 0.2), transparent 52%),
      #e8eadf;
  }

  .immersive-section::before {
    position: absolute;
    right: -0.04em;
    bottom: -0.22em;
    color: rgba(19, 56, 43, 0.06);
    content: "Milano";
    font-family: Georgia, "Times New Roman", serif;
    font-size: min(22vw, 300px);
    line-height: 1;
    pointer-events: none;
  }

  .cta.immersive {
    position: relative;
    grid-template-columns: minmax(0, 1fr) auto;
    border-radius: 0;
    border-top: 1px solid rgba(19, 56, 43, 0.16);
    border-bottom: 1px solid rgba(19, 56, 43, 0.16);
    background: transparent;
    padding: clamp(28px, 4vw, 40px) 0;
  }

  .cta.immersive h2 {
    max-width: 780px;
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .cta.immersive p:last-child {
    font-size: 1.08rem;
  }

  .cta-image {
    background-image:
      linear-gradient(90deg, rgba(255, 253, 248, 0.96), rgba(255, 253, 248, 0.78)),
      var(--cta-image);
    background-position: center;
    background-size: cover;
  }

  h2 {
    margin-bottom: 14px;
  }

  .cta-title {
    max-width: 780px;
    margin: 0 0 14px;
    color: var(--color-ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 500;
    line-height: 1.08;
  }

  .cta.immersive .cta-title {
    max-width: 860px;
    margin-bottom: 16px;
    font-size: clamp(2.1rem, 4.2vw, 3.6rem);
    line-height: 1.05;
  }

  p:last-child {
    max-width: 650px;
    margin-bottom: 0;
  }

  @media (max-width: 820px) {
    .cta {
      grid-template-columns: 1fr;
    }

    .cta.immersive {
      grid-template-columns: 1fr;
    }

    .cta.immersive .cta-title {
      font-size: clamp(1.9rem, 8vw, 2.6rem);
    }

    .immersive-section {
      padding: 48px 0;
    }

    .cta.immersive {
      padding: 28px 0;
    }
  }
</style>
