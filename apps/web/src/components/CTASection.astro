---
import { getSiteSettings } from "../lib/sanity";

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  primaryLabel?: string;
  primaryLink?: string;
  secondaryLabel?: string;
  secondaryLink?: string;
  imageUrl?: string;
  immersive?: boolean;
}

const settings = await getSiteSettings();
const {
  eyebrow = "Contatto diretto",
  title = "Iniziamo da una consulenza conoscitiva",
  text = "Raccontaci il tuo obiettivo: ti aiuteremo a capire quale percorso nutrizionale e piu adatto al tuo momento.",
  primaryLabel = "Scrivi su WhatsApp",
  primaryLink = settings.whatsapp || "/contatti",
  secondaryLabel = "Invia una email",
  secondaryLink = `mailto:${settings.email}`,
  imageUrl,
  immersive = false,
} = Astro.props;
---

<section class:list={["section", { "immersive-section": immersive }]}>
  <div class:list={["container", "cta", { "cta-image": imageUrl, immersive }]} style={imageUrl ? `--cta-image: url('${imageUrl}')` : undefined}>
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="button-row">
      <a class="button button-primary" href={primaryLink}>{primaryLabel}</a>
      <a class="button button-secondary" href={secondaryLink}>{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 30px;
    align-items: center;
    border-radius: 32px;
    background:
      radial-gradient(circle at 10% 15%, rgba(197, 155, 39, 0.18), transparent 34%),
      linear-gradient(135deg, rgba(120, 151, 124, 0.18), rgba(255, 247, 223, 0.72)),
      var(--color-white);
    padding: clamp(28px, 5vw, 54px);
  }

  .immersive-section {
    position: relative;
    overflow: hidden;
    padding: clamp(90px, 13vw, 170px) 0;
    background:
      radial-gradient(circle at 12% 10%, rgba(197, 155, 39, 0.16), transparent 28%),
      linear-gradient(135deg, rgba(120, 151, 124, 0.2), transparent 52%),
      #e8eadf;
  }

  .immersive-section::before {
    position: absolute;
    right: -0.04em;
    bottom: -0.22em;
    color: rgba(19, 56, 43, 0.06);
    content: "Milano";
    font-family: Georgia, "Times New Roman", serif;
    font-size: min(22vw, 300px);
    line-height: 1;
    pointer-events: none;
  }

  .cta.immersive {
    position: relative;
    grid-template-columns: minmax(0, 1fr) auto;
    border-radius: 0;
    border-top: 1px solid rgba(19, 56, 43, 0.16);
    border-bottom: 1px solid rgba(19, 56, 43, 0.16);
    background: transparent;
    padding: clamp(42px, 7vw, 78px) 0;
  }

  .cta.immersive h2 {
    max-width: 780px;
    font-size: clamp(2.15rem, 4.6vw, 4.05rem);
  }

  .cta.immersive p:last-child {
    font-size: 1.08rem;
  }

  .cta-image {
    background-image:
      linear-gradient(90deg, rgba(255, 253, 248, 0.96), rgba(255, 253, 248, 0.78)),
      var(--cta-image);
    background-position: center;
    background-size: cover;
  }

  h2 {
    margin-bottom: 14px;
  }

  p:last-child {
    max-width: 650px;
    margin-bottom: 0;
  }

  @media (max-width: 820px) {
    .cta {
      grid-template-columns: 1fr;
    }

    .cta.immersive {
      grid-template-columns: 1fr;
    }
  }
</style>
