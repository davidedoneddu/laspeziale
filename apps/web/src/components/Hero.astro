---
interface Props {
  title: string;
  subtitle: string;
  subheading?: string;
  imageUrl?: string;
  eyebrow?: string;
  primaryHref?: string;
  primaryLabel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  showActions?: boolean;
}

const {
  title,
  subtitle,
  subheading,
  imageUrl = "/assets/old-site/hero-header.jpg",
  eyebrow = "Studio nutrizionista La Speziale Milano",
  primaryHref = "/contatti",
  primaryLabel = "Prenota una consulenza",
  secondaryHref = "/programmi",
  secondaryLabel = "Scopri i programmi",
  showActions = true,
} = Astro.props;
---

<section class="hero" style={`--hero-image: url('${imageUrl}')`}>
  <div class="hero-image" aria-hidden="true"></div>
  <div class="hero-overlay">
    <div class="container hero-copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      {subheading && <p class="hero-subheading">{subheading}</p>}
      <p class="lead">{subtitle}</p>
      {showActions && (
        <div class="button-row">
          <a class="button button-primary" href={primaryHref}>{primaryLabel}</a>
          <a class="button button-secondary hero-secondary" href={secondaryHref}>{secondaryLabel}</a>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - 76px);
    overflow: hidden;
    background: #fbfdfd;
  }

  .hero-image {
    position: absolute;
    inset: -3%;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0.82) 36%, rgba(255, 255, 255, 0.32) 62%, rgba(255, 255, 255, 0.02)),
      var(--hero-image);
    background-position: 64% center;
    background-size: cover;
    animation: hero-arrival 1.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-image::after {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 80% 64%, rgba(120, 151, 124, 0.16), transparent 34%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(245, 249, 248, 0.42));
    content: "";
    pointer-events: none;
  }

  .hero-overlay {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: calc(100dvh - 76px);
    align-items: center;
    padding: 72px 0;
  }

  .hero-copy {
    color: #13382b;
  }

  .hero-copy > * {
    animation: hero-copy-arrival 760ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: 90ms;
  }

  .hero-copy > :nth-child(3) {
    animation-delay: 170ms;
  }

  .hero-copy > :nth-child(4) {
    animation-delay: 240ms;
  }

  .eyebrow,
  .hero-subheading,
  .lead {
    color: rgba(19, 56, 43, 0.78);
  }

  h1 {
    max-width: 780px;
    margin-bottom: 24px;
    color: #13382b;
    font-size: clamp(2.25rem, 5vw, 4rem);
    text-shadow: 0 18px 46px rgba(255, 255, 255, 0.42);
  }

  .hero-subheading {
    max-width: 760px;
    margin-bottom: 14px;
    color: #13382b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.18rem, 2.2vw, 1.65rem);
    font-weight: 700;
    line-height: 1.28;
  }

  .lead {
    margin-bottom: 32px;
  }

  .hero-secondary {
    border-color: rgba(19, 56, 43, 0.26);
    background: rgba(255, 255, 255, 0.58);
    color: #13382b;
  }

  @keyframes hero-arrival {
    from {
      opacity: 0.72;
      transform: scale(1.06);
      filter: blur(5px);
    }
    to {
      opacity: 1;
      transform: scale(1);
      filter: blur(0);
    }
  }

  @keyframes hero-copy-arrival {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  @media (max-width: 820px) {
    .hero,
    .hero-overlay {
      min-height: 620px;
    }

    .hero {
    }

    .hero-image {
      background-image:
        linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.88) 34%, rgba(255, 255, 255, 0.42) 68%, rgba(255, 255, 255, 0.08) 100%),
        var(--hero-image);
      background-position: 64% center;
    }

    h1 {
      font-size: clamp(2.15rem, 10vw, 3rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image,
    .hero-copy > * {
      animation: none;
    }
  }
</style>
