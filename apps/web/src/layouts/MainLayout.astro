---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import { getSiteSettings } from "../lib/sanity";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const settings = await getSiteSettings();
const {
  title = settings.seo?.title || "Studio nutrizionista La Speziale Milano",
  description = settings.seo?.description || "Nutrizione integrata, alimentazione personalizzata, fitoterapia e programmi benessere a Milano.",
  image = settings.seo?.imageUrl || settings.logoUrl || "/assets/old-site/logo.png",
  noindex = false,
} = Astro.props;
const pageTitle = title.includes("La Speziale") ? title : `${title} | La Speziale`;
const canonical = Astro.url.href;
const favicon = settings.faviconUrl || settings.logoUrl || "/assets/old-site/logo.png";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href={favicon} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url).href} />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
  </body>
</html>
