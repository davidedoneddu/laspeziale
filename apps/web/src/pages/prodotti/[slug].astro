---
import { ExternalLink } from "@lucide/astro";
import MainLayout from "../../layouts/MainLayout.astro";
import CTASection from "../../components/CTASection.astro";
import { blocksToText, getProduct, getProducts } from "../../lib/sanity";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({params: {slug: product.slug}}));
}

const product = Astro.params.slug ? await getProduct(Astro.params.slug) : undefined;
if (!product) return Astro.rewrite("/404?kind=product");
const paragraphs = blocksToText(product.description || []);
---

<MainLayout title={product.seo?.title || product.title} description={product.seo?.description || product.excerpt} image={product.seo?.imageUrl || product.imageUrl}>
  <article>
    <section class="product-hero">
      <div class="container product-layout">
        <div class="product-photo">
          {product.imageUrl ? <img src={product.imageUrl} alt={product.imageAlt || product.title} /> : <div class="product-photo-fallback"></div>}
        </div>
        <div class="product-copy">
          <p class="eyebrow">{product.category || "Prodotto La Speziale"}</p>
          <h1>{product.title}</h1>
          {product.excerpt && <p class="lead">{product.excerpt}</p>}
          {product.price && <p class="product-price">{product.price}</p>}
          <div class="product-hero-actions">
            {product.purchaseUrl && (
              <a class="button button-primary" href={product.purchaseUrl} target="_blank" rel="noopener noreferrer">
                {product.purchaseLabel || "Acquista"} <ExternalLink size={17} aria-hidden="true" />
              </a>
            )}
            <a class="button button-secondary" href={product.ctaLink || "/contatti"}>{product.ctaLabel || "Richiedi informazioni"}</a>
          </div>
          {product.relatedTherapies?.length && (
            <div class="therapy-actions" aria-label="Fitoterapie collegate">
              {product.relatedTherapies.map((therapy) => (
                <a class="button therapy-button" href={`/fitoterapia/${therapy.slug}/`}>Vai alla terapia {therapy.title}</a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>

    {(paragraphs.length > 0 || product.features?.length) && (
      <section class="section section-soft">
        <div class="container product-details">
          {paragraphs.length > 0 && <div><h2>{product.descriptionTitle || "Descrizione"}</h2>{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>}
          {product.features?.length && <aside><h2>{product.featuresTitle || "Caratteristiche"}</h2><ul class="text-list">{product.features.map((feature) => <li>{feature}</li>)}</ul></aside>}
        </div>
      </section>
    )}
    <CTASection title={`Vuoi maggiori informazioni su ${product.title}?`} text="Contattaci direttamente per disponibilita e indicazioni." />
  </article>
</MainLayout>

<style>
  .product-hero { padding:72px 0; background:#fffefa; }
  .product-layout { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,.9fr); gap:56px; align-items:center; }
  .product-photo { overflow:hidden; aspect-ratio:4/3; border-radius:16px; background:#eef0e8; box-shadow:var(--shadow-soft); }
  .product-photo img { width:100%; height:100%; object-fit:cover; }
  .product-photo-fallback { width:100%; height:100%; background:linear-gradient(135deg,#d8e0d1,#f1e5d3); }
  .product-price { color:var(--color-ink); font-size:1.2rem; font-weight:850; }
  .product-hero-actions, .therapy-actions { display:flex; flex-wrap:wrap; gap:12px; margin-top:22px; }
  .product-hero-actions .button { display:inline-flex; align-items:center; justify-content:center; gap:8px; }
  .therapy-actions { border-top:1px solid rgba(38,51,44,.12); padding-top:20px; }
  .therapy-button { border:1px solid rgba(93,120,95,.28); background:#eef3ec; color:var(--color-ink); }
  .product-details { display:grid; grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr); gap:52px; }
  .product-details aside { border-left:1px solid rgba(38,51,44,.12); padding-left:32px; }
  @media (max-width:820px) { .product-layout, .product-details { grid-template-columns:1fr; } .product-details aside { border-left:0; border-top:1px solid rgba(38,51,44,.12); padding:28px 0 0; } }
</style>
