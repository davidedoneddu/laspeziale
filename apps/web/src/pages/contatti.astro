---
import { Clock3, Mail, MapPin } from "@lucide/astro";
import MainLayout from "../layouts/MainLayout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import CTASection from "../components/CTASection.astro";
import { getContactPage, getSiteSettings } from "../lib/sanity";

const [settings, page] = await Promise.all([getSiteSettings(), getContactPage()]);
const mapQuery = page.mapQuery || settings.address || "Milano";
const encodedMapQuery = encodeURIComponent(mapQuery);
const mapEmbedUrl = `https://www.google.com/maps?q=${encodedMapQuery}&output=embed`;
const mapExternalUrl = page.mapUrl || `https://www.google.com/maps/search/?api=1&query=${encodedMapQuery}`;
const instagramUrl = settings.instagram && settings.instagram !== "https://www.instagram.com/" ? settings.instagram : "https://www.instagram.com/laspezialemilano/";
const facebookUrl = settings.facebook && settings.facebook !== "https://www.facebook.com/" ? settings.facebook : "https://www.facebook.com/laspeziale.it/";
const socialLinks = [
  { href: instagramUrl, label: "Instagram", icon: "instagram" },
  { href: facebookUrl, label: "Facebook", icon: "facebook" },
].filter((link) => Boolean(link.href));
---

<MainLayout title={page.seo?.title} description={page.seo?.description || page.heroText} image={page.seo?.imageUrl || page.heroImageUrl}>
  <section class="page-hero contact-hero">
    <div class="container contact-hero-copy">
      <h1>{page.heroTitle}</h1>
      {page.heroText && <p class="lead">{page.heroText}</p>}
    </div>
  </section>

  <section class="section section-soft contact-overview">
    <div class="container contact-intro">
      <article class="contact-intro-card">
        <MapPin size={46} stroke-width={1.5} aria-hidden="true" />
        <h2>{page.locationTitle || "Dove siamo"}</h2>
        <p>{settings.locationText}</p>
      </article>
      <article class="contact-intro-card">
        <Clock3 size={46} stroke-width={1.5} aria-hidden="true" />
        <h2>{page.hoursTitle || "Orari di apertura"}</h2>
        <p>{page.hoursIntro}<br />{settings.openingHours?.split("\n").map((line) => <>{line}<br /></>)}</p>
      </article>
      <article class="contact-intro-card">
        <Mail size={46} stroke-width={1.5} aria-hidden="true" />
        <h2>{page.contactTitle || "Contattaci"}</h2>
        <p>{settings.contactText}</p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div>
        <SectionTitle title={page.formTitle || "Scrivici"} text={page.formText} />
        <form class="surface form-grid" name="contatti" method="POST" action="/grazie" data-netlify="true" netlify-honeypot="bot-field" data-contact-form>
          <input type="hidden" name="form-name" value="contatti" />
          <p class="form-hidden">
            <label>Non compilare questo campo<input name="bot-field" autocomplete="off" /></label>
          </p>
          <label>{page.nameLabel || "Nome e cognome"}<input type="text" name="name" placeholder={page.namePlaceholder} autocomplete="name" required /></label>
          <label>{page.emailLabel || "Email"}<input type="email" name="email" placeholder={page.emailPlaceholder} autocomplete="email" required /></label>
          <label>{page.messageLabel || "Messaggio"}<textarea name="message" placeholder={page.messagePlaceholder} required></textarea></label>
          <button class="button button-primary" type="submit" data-submit-label={page.submitLabel || "Invia richiesta"}>{page.submitLabel || "Invia richiesta"}</button>
        </form>
      </div>
      <aside class="contact-side">
        <div class="surface contact-box"><h2>{page.addressTitle || "Indirizzo"}</h2><p>{settings.address}</p></div>
        <div class="surface contact-box">
          <h2>{page.contactsTitle || "Contatti"}</h2>
          <p>Tel: <a href={`tel:${settings.phone.replaceAll(" ", "")}`}>{settings.phone}</a><br />Email: <a href={`mailto:${settings.email}`}>{settings.email}</a></p>
          <div class="social-links" aria-label="Social La Speziale">
            {socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`La Speziale su ${link.label}`}>
                {link.icon === "instagram" ? (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="4" y="4" width="16" height="16" rx="5" />
                    <circle cx="12" cy="12" r="3.6" />
                    <circle class="icon-dot" cx="16.7" cy="7.3" r="0.8" />
                  </svg>
                ) : (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M14.2 8.2h2.1V4.8h-2.8c-3.1 0-4.8 1.9-4.8 4.9v2H6v3.6h2.7V21h3.8v-5.7h3.1l0.5-3.6h-3.6V10c0-1.1 0.5-1.8 1.7-1.8Z" />
                  </svg>
                )}
              </a>
            ))}
          </div>
        </div>
        <div class="map-panel surface">
          <div class="map-frame" data-consent-map>
            <iframe
              data-map-frame
              data-src={mapEmbedUrl}
              title={page.mapLabel || "Mappa della sede La Speziale"}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen
              hidden
            ></iframe>
            <div class="map-consent" data-map-placeholder>
              <span class="map-icon"><MapPin size={30} stroke-width={1.8} aria-hidden="true" /></span>
              <div>
                <h3>Mappa interattiva</h3>
                <p>Per mostrare Google Maps serve il consenso ai contenuti esterni.</p>
              </div>
              <button class="button button-secondary" type="button" data-enable-map>Mostra la mappa</button>
            </div>
          </div>
          <div class="map-toolbar">
            <span>{page.mapLabel || "Studio Nutrizionista La Speziale Milano"}</span>
            <a href={mapExternalUrl} target="_blank" rel="noopener noreferrer">Apri in Google Maps</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  {page.cta?.title && <CTASection {...page.cta} />}
</MainLayout>

<style>
  .contact-hero { background:var(--color-white); }
  .contact-hero-copy { max-width:860px; text-align:center; }
  .contact-hero-copy h1, .contact-hero-copy .lead { margin-right:auto; margin-left:auto; }
  .contact-hero-copy .lead { max-width:720px; }
  .contact-overview { padding-top:24px; }
  .contact-intro { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); max-width:1120px; overflow:hidden; border:1px solid var(--color-border); border-radius:var(--radius); background:var(--color-white); box-shadow:var(--shadow-soft); }
  .contact-intro-card { padding:34px 30px; text-align:center; }
  .contact-intro-card + .contact-intro-card { border-left:1px solid var(--color-border); }
  .contact-intro-card > svg { display:block; margin:0 auto 20px; color:var(--color-sage); }
  .contact-intro h2 { margin:0 0 14px; font-family:Georgia,"Times New Roman",serif; font-size:clamp(1.4rem,2vw,1.8rem); font-weight:400; }
  .contact-intro p { margin:0; line-height:1.7; }
  .contact-grid { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr); gap:28px; }
  form { padding:24px; }
  .form-hidden { position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); clip-path:inset(50%); white-space:nowrap; }
  button { border:0; cursor:pointer; }
  button[aria-disabled="true"] { cursor:wait; opacity:.74; transform:none; }
  .contact-side { display:grid; gap:22px; }
  .contact-box { padding:28px; }
  .contact-box h2 { font-family:Georgia,"Times New Roman",serif; font-size:2rem; }
  .social-links { display:flex; gap:10px; margin-top:18px; }
  .social-links a { display:grid; width:40px; height:40px; place-items:center; border:1px solid rgba(19,56,43,.16); border-radius:50%; background:rgba(232,234,223,.58); color:var(--color-primary); transition:background 180ms ease,border-color 180ms ease,color 180ms ease; }
  .social-links a:hover, .social-links a:focus { border-color:var(--color-cta); background:var(--color-cta); color:var(--color-white); }
  .social-links svg { width:18px; height:18px; fill:none; stroke:currentColor; stroke-linecap:round; stroke-linejoin:round; stroke-width:1.8; }
  .social-links .icon-dot { fill:currentColor; stroke:none; }
  .map-panel { display:block; overflow:hidden; }
  .map-frame { position:relative; min-height:360px; background:#e7ebe2; }
  .map-panel iframe { display:block; width:100%; height:360px; border:0; background:#e7ebe2; }
  .map-consent { position:absolute; inset:0; display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:18px; align-items:center; padding:32px; background:linear-gradient(135deg,#e7ebe2,#f5f0e6); }
  .map-consent[hidden], .map-panel iframe[hidden] { display:none; }
  .map-icon { display:grid; width:58px; height:58px; place-items:center; border-radius:50%; background:var(--color-white); color:var(--color-sage-dark); box-shadow:0 12px 30px rgba(38,51,44,.12); }
  .map-consent h3 { margin:0 0 6px; font-size:1.2rem; }
  .map-consent p { max-width:390px; margin:0; }
  .map-consent .button { width:auto; white-space:nowrap; }
  .map-toolbar { display:flex; align-items:center; justify-content:space-between; gap:20px; border-top:1px solid rgba(38,51,44,.1); padding:16px 20px; background:var(--color-white); }
  .map-toolbar span { color:var(--color-muted); font-size:.9rem; }
  .map-toolbar a { flex:none; color:var(--color-sage-dark); font-weight:800; }
  .map-toolbar a:hover { text-decoration:underline; text-underline-offset:3px; }
  @media (max-width:560px) { .map-consent { grid-template-columns:1fr; align-content:center; justify-items:start; padding:24px; } .map-consent .button { width:100%; } .map-toolbar { align-items:flex-start; flex-direction:column; gap:8px; } }
  @media (max-width:820px) {
    .contact-overview { padding-top:0; }
    .contact-intro, .contact-grid { grid-template-columns:1fr; }
    .contact-intro-card { padding:28px 24px; }
    .contact-intro-card + .contact-intro-card { border-top:1px solid var(--color-border); border-left:0; }
  }
</style>

<script>
  type ConsentState = { externalMedia?: boolean };
  type ConsentManager = { get: () => ConsentState | null; setExternalMedia: (allowed: boolean) => void };
  const manager = () => (window as typeof window & { LaSpezialeConsent?: ConsentManager }).LaSpezialeConsent;
  const mapRoot = document.querySelector<HTMLElement>("[data-consent-map]");
  const frame = mapRoot?.querySelector<HTMLIFrameElement>("[data-map-frame]");
  const placeholder = mapRoot?.querySelector<HTMLElement>("[data-map-placeholder]");
  const enableButton = mapRoot?.querySelector<HTMLButtonElement>("[data-enable-map]");

  const syncMap = (consent?: ConsentState | null) => {
    if (!frame || !placeholder) return;
    const allowed = consent?.externalMedia === true;
    if (allowed && !frame.hasAttribute("src")) frame.src = frame.dataset.src || "";
    if (!allowed) frame.removeAttribute("src");
    frame.hidden = !allowed;
    placeholder.hidden = allowed;
  };

  document.addEventListener("laspeziale:consent", (event) => {
    syncMap((event as CustomEvent<ConsentState>).detail);
  });
  window.addEventListener("load", () => syncMap(manager()?.get()));
  enableButton?.addEventListener("click", () => manager()?.setExternalMedia(true));

  const contactForm = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const submitButton = contactForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  let isSubmitting = false;

  contactForm?.addEventListener("submit", (event) => {
    if (isSubmitting) {
      event.preventDefault();
      return;
    }

    isSubmitting = true;
    if (submitButton) {
      submitButton.textContent = "Invio in corso...";
      submitButton.disabled = true;
      submitButton.setAttribute("aria-disabled", "true");
    }
  });
</script>
