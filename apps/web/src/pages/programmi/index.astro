---
import MainLayout from "../../layouts/MainLayout.astro";
import SectionTitle from "../../components/SectionTitle.astro";
import CTASection from "../../components/CTASection.astro";
import { getPrograms, getProgramsPage } from "../../lib/sanity";

const [programs, page] = await Promise.all([getPrograms(), getProgramsPage()]);
const hiddenProgramSlugs = new Set(["nutrizione-integrata", "fitoterapia-erbe-officinali-nutraceutici", "consapevolezza-motivazione"]);
const visiblePrograms = programs.filter((program) => !hiddenProgramSlugs.has(program.slug) && !program.slug.includes("fitoterapia"));
const programCardContent: Record<string, { title: string; text: string }> = {
  "gestione-peso-ricomposizione-corporea": {
    title: "Gestione del Peso e Ricomposizione Corporea",
    text: "Quando il peso si blocca, la cellulite persiste o il corpo cambia forma, mangiare meno non è sempre la risposta. Lavoriamo sui meccanismi che possono rendere più difficile perdere grasso, ritrovare tono e modificare le zone critiche.",
  },
  "gonfiore-disturbi-intestinali": {
    title: "Gonfiore e disturbi intestinali",
    text: "Il gonfiore è un sintomo, non una spiegazione. Frequenza, intensità, regolarità intestinale, digestione e risposta agli alimenti aiutano a ricostruire ciò che accade e a individuare i fattori su cui lavorare.",
  },
  "menopausa-premenopausa": {
    title: "Le Fasi della Donna",
    text: "Il corpo non risponde allo stesso modo a 30, 45 o 55 anni. Ciclo, perimenopausa e menopausa possono cambiare metabolismo, forme, distribuzione del grasso, fame, sonno ed energia: anche le strategie devono cambiare.",
  },
  "programma-anti-age": {
    title: "Longevità e Vitalità",
    text: "Il tempo cambia il corpo in molti modi. La pelle può perdere elasticità, i muscoli energia e forza, il recupero diventare più lento. Alimentazione e nutrienti vengono scelti per accompagnare questi cambiamenti e preservare vitalità e tono.",
  },
  "nutrizione-sportiva": {
    title: "Nutrizione Sportiva",
    text: "Il risultato non si costruisce solo durante l'allenamento. Cosa mangi, quando lo mangi e come recuperi può cambiare energia e resa durante l'attività. La strategia viene costruita sullo sport che pratichi, sui tuoi allenamenti e sul risultato che vuoi raggiungere.",
  },
};
---

<MainLayout title={page.seo?.title} description={page.seo?.description || page.heroText} image={page.seo?.imageUrl}>
  <section class="programs-hero">
    <div class="container programs-hero-copy">
      <h1>Cosa trattiamo</h1>
      <p class="hero-highlight">Non esiste un unico punto da cui iniziare.</p>
      <p class="lead">
        Peso, intestino, cambiamenti ormonali, vitalità e attività fisica possono richiedere attenzioni diverse. Per questo il Metodo La Speziale si adatta all'obiettivo e alla fase che stai vivendo.
      </p>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <SectionTitle
        title="Trova il percorso più vicino a ciò che vuoi migliorare"
        text="Cinque aree di intervento, costruite intorno a esigenze e obiettivi diversi."
      />
      <div class="program-grid">
        {visiblePrograms.map((program) => {
          const card = programCardContent[program.slug] || { title: program.title, text: program.excerpt };
          return (
          <article class="program-card surface">
            <div class="program-thumb" style={`--program-image: url('${program.imageUrl || "/assets/old-site/hero-bright-wellbeing.png"}')`} role="img" aria-label={program.title}></div>
            <div class="program-body">
              <h3>{card.title}</h3>
              <p>{card.text}</p>
              <a class="button button-secondary" href={`/programmi/${program.slug}`}>{page.cardButtonLabel || "Scopri di più"}</a>
            </div>
          </article>
          );
        })}
      </div>
    </div>
  </section>

  <CTASection
    {...page.cta}
    title="Non sai quale percorso scegliere?"
    text="Raccontaci cosa vorresti migliorare: ti aiuteremo a individuare il percorso da cui partire."
  />
</MainLayout>

<style>
  .programs-hero {
    background:
      radial-gradient(circle at 15% 12%, rgba(120, 151, 124, 0.13), transparent 32%),
      linear-gradient(135deg, var(--color-white) 0%, var(--color-ivory) 62%, var(--color-beige) 100%);
    padding: clamp(52px, 7vw, 88px) 0 clamp(48px, 6vw, 72px);
  }

  .programs-hero-copy {
    max-width: 860px;
  }

  .programs-hero h1 {
    margin-bottom: 18px;
    color: var(--color-primary);
    font-size: clamp(2.45rem, 4.8vw, 4.05rem);
    line-height: 1.04;
  }

  .hero-highlight {
    margin-bottom: 14px;
    color: var(--color-ink);
    font-size: clamp(1.18rem, 2vw, 1.45rem);
    font-weight: 800;
    line-height: 1.42;
  }

  .programs-hero .lead {
    max-width: 760px;
    margin: 0;
  }

  .program-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .program-card {
    display: grid;
    overflow: hidden;
  }

  .program-thumb {
    aspect-ratio: 3 / 2;
    min-height: 0;
    background-image: linear-gradient(rgba(16, 24, 20, 0.04), rgba(16, 24, 20, 0.04)), var(--program-image);
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100% 100%, contain;
    background-color: #eef2ec;
  }

  .program-body {
    display: flex;
    flex-direction: column;
    padding: 26px;
  }

  .program-body h3 {
    margin-bottom: 14px;
    color: var(--color-primary);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.55rem, 2.5vw, 2.05rem);
    font-weight: 500;
    line-height: 1.13;
  }

  .program-body p {
    flex: 1;
    line-height: 1.68;
  }

  .program-body .button {
    align-self: flex-start;
    margin-top: 10px;
  }

  @media (max-width: 780px) {
    .programs-hero {
      padding: 48px 0;
    }

    .program-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .program-thumb {
      min-height: 0;
    }

    .program-body {
      padding: 24px 20px;
    }

    .program-body .button {
      width: 100%;
    }
  }
</style>
