---
import { ArrowRight, CircleCheck } from "@lucide/astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { getTherapiesPage } from "../../lib/sanity";

const page = await getTherapiesPage();

const usefulItems = page.usefulItems || [];
const includedItems = page.includedItems || [];
const faqs = page.faqs || [];
const expertiseParagraphs = (page.expertiseText || "")
  .split(/\n+/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean);
---

<MainLayout title={page.seo?.title} description={page.seo?.description || page.heroText} image={page.seo?.imageUrl || page.heroImageUrl}>
  <section class="phyto-hero" style={`--phyto-image: url('${page.heroImageUrl || "/assets/old-site/fitoterapia-consulenza-2026.jpg"}')`}>
    <div class="container phyto-hero-inner">
      <div class="phyto-hero-copy">
        <h1>{page.heroTitle}</h1>
        {page.heroSubtitle && <p class="hero-subtitle">{page.heroSubtitle}</p>}
        {page.heroText && <p class="lead">{page.heroText}</p>}
        <div class="button-row">
          <a class="button phyto-primary" href="#prenota">Richiedi una consulenza</a>
        </div>
      </div>
      <div class="phyto-visual" role="img" aria-label="Piante officinali e preparazioni per il Consiglio Fitoterapico">
        <div class="phyto-photo"></div>
      </div>
    </div>
  </section>

  <section class="section phyto-intro">
    <div class="container split-panel">
      <div>
        <h2>{page.contentTitle || "Perché richiedere un consiglio fitoterapico?"}</h2>
        <p class="section-subtitle">{page.gridTitle || "Molti prodotti naturali sembrano simili, ma non lo sono."}</p>
      </div>
      <div class="split-copy">
        <p>La scelta dipende dalla persona, dalle sue esigenze, dalle eventuali terapie in corso e dall'obiettivo che desidera raggiungere.</p>
        <p>{page.gridText || "Per questo il valore della consulenza non è il prodotto, ma la valutazione professionale che porta a scegliere la soluzione più adatta."}</p>
      </div>
    </div>
  </section>

  <section class="section phyto-service">
    <div class="container service-panel">
      <div>
        <h2>{page.usefulTitle || "Quando può essere utile?"}</h2>
        <p class="section-subtitle">{page.usefulSubtitle || "Una consulenza mirata quando vuoi scegliere con metodo."}</p>
      </div>
      <div class="service-columns">
        <article>
          <h3>Quando richiederla</h3>
          <ul>
            {usefulItems.map((item) => (
              <li><CircleCheck size={16} stroke-width={2.5} aria-hidden="true" />{item}</li>
            ))}
          </ul>
        </article>
        <article>
          <h3>{page.includedTitle || "Cosa comprende"}</h3>
          <ul>
            {includedItems.map((item) => (
              <li><CircleCheck size={16} stroke-width={2.5} aria-hidden="true" />{item}</li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section phyto-expertise">
    <div class="container expertise-grid">
      <div>
        <h2>{page.expertiseTitle || "Perché affidarsi a una Farmacista specializzata?"}</h2>
        <p class="section-subtitle">{page.expertiseSubtitle || "La fitoterapia richiede competenze specifiche."}</p>
        {expertiseParagraphs.length
          ? expertiseParagraphs.map((paragraph) => <p>{paragraph}</p>)
          : (
              <>
                <p>Conoscere le proprietà delle piante officinali significa anche saperne valutare qualità, possibili interazioni, controindicazioni e reale utilità.</p>
                <p>Ogni consiglio nasce dalla persona, dalle sue caratteristiche e dai suoi obiettivi, mai da una scelta standardizzata.</p>
              </>
            )}
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section phyto-faq" aria-labelledby="phyto-faq-title">
      <div class="container faq-panel">
        <h2 id="phyto-faq-title">{page.faqsTitle || "Domande frequenti"}</h2>
        <div class="faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>
                <span>{faq.question}</span>
                <span class="faq-symbol" aria-hidden="true">+</span>
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section phyto-booking" id="prenota">
    <div class="container booking-panel">
      <h2>{page.cta?.title || "Hai bisogno di un consiglio professionale?"}</h2>
      <p>{page.cta?.text || "Prenota una consulenza e confrontati con una Farmacista specializzata in Fitoterapia per individuare la soluzione più adatta alle tue esigenze."}</p>
      <a class="button booking-button" href={page.cta?.primaryLink || "/contatti"}>
        {page.cta?.primaryLabel || "Richiedi una consulenza"} <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
  </section>
</MainLayout>

<style>
  .section-subtitle {
    max-width: 680px;
    margin: 14px 0 0;
    color: #244D3D;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.18rem, 2.2vw, 1.55rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .phyto-hero {
    background:
      radial-gradient(circle at 12% 10%, rgba(197, 155, 39, 0.14), transparent 30%),
      linear-gradient(135deg, #fffdf8 0%, #fcfbf7 46%, #eef2ec 100%);
    padding: clamp(56px, 6vw, 80px) 0;
  }

  .phyto-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.72fr);
    gap: clamp(34px, 7vw, 86px);
    align-items: center;
  }

  .phyto-hero-copy {
    max-width: 820px;
  }

  .phyto-hero h1 {
    max-width: 900px;
    color: #244D3D;
    font-size: clamp(2.15rem, 4.7vw, 3.85rem);
  }

  .hero-subtitle {
    color: #244D3D;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.15rem, 2.3vw, 1.65rem);
    font-weight: 700;
    margin: 0 0 18px;
  }

  .phyto-primary {
    background: #c59b27;
    color: white;
  }

  .phyto-primary:hover,
  .booking-button:hover {
    background: #a8801d;
  }

  .phyto-visual {
    position: relative;
    aspect-ratio: 3 / 2;
    min-height: 0;
  }

  .phyto-photo {
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    background-image:
      linear-gradient(180deg, rgba(19, 56, 43, 0.03), rgba(19, 56, 43, 0.1)),
      var(--phyto-image);
    background-position: 48% center;
    background-repeat: no-repeat;
    background-size: 100% 100%, contain;
    background-color: #eef2ec;
    box-shadow: var(--shadow-soft);
  }

  .phyto-intro,
  .phyto-faq,
  .phyto-booking {
    background: #fcfbf7;
  }

  .phyto-faq {
    padding-bottom: 24px;
  }

  .phyto-booking {
    padding-top: 24px;
    padding-bottom: 48px;
  }

  .split-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(34px, 6vw, 82px);
    align-items: start;
  }

  .split-panel h2,
  .service-panel h2,
  .expertise-grid h2,
  .booking-panel h2 {
    color: #244D3D;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.06;
  }

  .split-copy {
    display: grid;
    gap: 18px;
    max-width: 700px;
  }

  .split-copy p,
  .expertise-grid p {
    color: #4F5B55;
    font-size: 1.04rem;
    line-height: 1.78;
    margin: 0;
  }

  .phyto-service {
    background: #fffdf8;
  }

  .service-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 34px;
    border: 1px solid rgba(197, 155, 39, 0.24);
    border-radius: 28px;
    background: #fff7df;
    padding: clamp(26px, 5vw, 48px);
  }

  .service-panel h2 {
    color: #244D3D;
  }

  .service-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .service-columns article {
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.58);
    padding: 22px;
  }

  .service-columns h3 {
    color: #244D3D;
    margin-bottom: 12px;
  }

  .service-columns ul {
    display: grid;
    gap: 11px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-columns li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: #244D3D;
    line-height: 1.55;
  }

  .service-columns svg {
    flex: 0 0 auto;
    color: #244D3D;
    margin-top: 4px;
  }

  .phyto-expertise {
    background: #fcfbf7;
  }

  .expertise-grid {
    max-width: 900px;
  }

  .expertise-grid h2 {
    margin-bottom: 18px;
  }

  .expertise-grid p + p {
    margin-top: 14px;
  }

  .faq-panel {
    max-width: 980px;
  }

  .faq-panel h2 {
    margin-bottom: 30px;
    color: #244D3D;
    font-size: clamp(2rem, 4vw, 3.4rem);
  }

  .faq-list {
    overflow: hidden;
    border: 1px solid rgba(38, 51, 44, 0.12);
    border-radius: var(--radius);
    background: white;
  }

  .faq-list details + details {
    border-top: 1px solid rgba(38, 51, 44, 0.1);
  }

  .faq-list summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    cursor: pointer;
    color: #244D3D;
    font-weight: 800;
    line-height: 1.45;
    padding: 20px 24px;
    list-style: none;
  }

  .faq-list summary::-webkit-details-marker {
    display: none;
  }

  .faq-symbol {
    color: #244D3D;
    font-size: 1.5rem;
    font-weight: 500;
    transition: transform 180ms ease;
  }

  .faq-list details[open] .faq-symbol {
    transform: rotate(45deg);
  }

  .faq-list details p {
    max-width: 720px;
    margin: 0;
    color: #4F5B55;
    line-height: 1.7;
    padding: 0 24px 22px;
  }

  .booking-panel {
    display: grid;
    max-width: none;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: clamp(40px, 6vw, 88px);
    align-items: center;
    border-radius: 28px;
    background:
      radial-gradient(circle at 8% 18%, rgba(120, 151, 124, 0.18), transparent 36%),
      linear-gradient(135deg, rgba(232, 234, 223, 0.82), rgba(255, 247, 223, 0.62)),
      var(--color-white);
    color: var(--color-ink);
    padding: clamp(40px, 5vw, 64px);
    text-align: left;
  }

  .booking-panel .eyebrow {
    color: #244D3D;
  }

  .booking-panel h2,
  .booking-panel p {
    grid-column: 1;
  }

  .booking-panel h2 {
    color: var(--color-primary);
    margin-bottom: 16px;
    font-size: clamp(2.35rem, 4vw, 3.35rem);
  }

  .booking-panel p {
    max-width: 720px;
    margin-bottom: 0;
    color: var(--color-muted);
  }

  .booking-button {
    display: inline-flex;
    grid-column: 2;
    grid-row: 1 / 3;
    gap: 8px;
    align-items: center;
    background: var(--color-cta);
    color: white;
    white-space: nowrap;
  }

  .booking-button:hover,
  .booking-button:focus {
    background: var(--color-cta-hover);
  }

  @media (max-width: 980px) {
    .phyto-hero-inner,
    .split-panel,
    .service-panel,
    .service-columns {
      grid-template-columns: 1fr;
    }

    .phyto-visual {
      min-height: 0;
    }

    .phyto-faq {
      padding-bottom: 20px;
    }

    .phyto-booking {
      padding-top: 20px;
      padding-bottom: 40px;
    }

    .booking-panel {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      gap: 0;
      padding: 32px 24px;
    }

    .booking-button {
      width: fit-content;
      grid-column: 1;
      grid-row: auto;
      margin-top: 24px;
    }

  }

  @media (max-width: 560px) {
    .booking-panel h2 {
      font-size: clamp(2rem, 10vw, 2.55rem);
    }

    .booking-button {
      width: 100%;
    }
  }
</style>
