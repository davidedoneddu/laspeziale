---
import { ArrowRight, CircleCheck, Leaf, ShieldCheck } from "@lucide/astro";
import MainLayout from "../../layouts/MainLayout.astro";
import { getTherapiesPage } from "../../lib/sanity";

const page = await getTherapiesPage();

const usefulItems = [
  "Vuoi un supporto naturale per un'esigenza specifica.",
  "Assumi farmaci e desideri verificare eventuali interazioni.",
  "Hai gia provato diversi prodotti senza ottenere i risultati sperati.",
  "Ti e stato consigliato un integratore e desideri un parere professionale.",
  'Cerchi una scelta personalizzata, evitando il "fai da te".',
];

const includedItems = [
  "Analisi delle tue esigenze.",
  "Valutazione di eventuali farmaci e integratori gia utilizzati.",
  "Selezione di piante officinali e nutraceutici realmente indicati.",
  "Indicazioni su modalita di utilizzo e durata.",
  "Risposta ai tuoi dubbi e alle tue domande.",
];
---

<MainLayout title={page.seo?.title} description={page.seo?.description || page.heroText} image={page.seo?.imageUrl || page.heroImageUrl}>
  <section class="phyto-hero">
    <div class="container phyto-hero-inner">
      <div class="phyto-hero-copy">
        <p class="eyebrow">{page.heroEyebrow || "Il Consiglio Fitoterapico"}</p>
        <h1>{page.heroTitle}</h1>
        {page.heroText && <p class="lead">{page.heroText}</p>}
        <div class="button-row">
          <a class="button phyto-primary" href="#prenota">Richiedi una consulenza</a>
        </div>
      </div>
      <aside class="phyto-note" aria-label="Consiglio fitoterapico">
        <span>Valutazione professionale</span>
        <strong>Un buon rimedio naturale inizia sempre da una buona valutazione.</strong>
        <p>La scelta nasce dalla persona, dalle sue esigenze, dalle eventuali terapie in corso e dall'obiettivo da raggiungere.</p>
      </aside>
    </div>
  </section>

  <section class="section phyto-intro">
    <div class="container split-panel">
      <div>
        <p class="eyebrow">{page.contentTitle || "Perche richiedere un consiglio fitoterapico?"}</p>
        <h2>{page.gridTitle || "Molti prodotti naturali sembrano simili, ma non lo sono."}</h2>
      </div>
      <div class="split-copy">
        <p>La scelta dipende dalla persona, dalle sue esigenze, dalle eventuali terapie in corso e dall'obiettivo che desidera raggiungere.</p>
        <p>Per questo il valore della consulenza non e il prodotto, ma la valutazione professionale che porta a scegliere la soluzione piu adatta.</p>
      </div>
    </div>
  </section>

  <section class="section phyto-service">
    <div class="container service-panel">
      <div>
        <p class="eyebrow">Quando puo essere utile?</p>
        <h2>Una consulenza mirata quando vuoi scegliere con metodo.</h2>
      </div>
      <div class="service-columns">
        <article>
          <h3>Quando richiederla</h3>
          <ul>
            {usefulItems.map((item) => (
              <li><CircleCheck size={16} stroke-width={2.5} aria-hidden="true" />{item}</li>
            ))}
          </ul>
        </article>
        <article>
          <h3>Cosa comprende</h3>
          <ul>
            {includedItems.map((item) => (
              <li><CircleCheck size={16} stroke-width={2.5} aria-hidden="true" />{item}</li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section phyto-expertise">
    <div class="container expertise-grid">
      <div class="expertise-icon"><Leaf size={30} stroke-width={1.8} aria-hidden="true" /></div>
      <div>
        <p class="eyebrow">Perche affidarsi a una Farmacista specializzata?</p>
        <h2>La fitoterapia richiede competenze specifiche.</h2>
        <p>Conoscere le proprieta delle piante officinali significa anche saperne valutare qualita, possibili interazioni, controindicazioni e reale utilita.</p>
        <p>Ogni consiglio nasce dalla persona, dalle sue caratteristiche e dai suoi obiettivi, mai da una scelta standardizzata.</p>
      </div>
      <div class="expertise-icon secondary"><ShieldCheck size={30} stroke-width={1.8} aria-hidden="true" /></div>
    </div>
  </section>

  <section class="section phyto-booking" id="prenota">
    <div class="container booking-panel">
      <p class="eyebrow">{page.cta?.eyebrow || "CTA"}</p>
      <h2>{page.cta?.title || "Hai bisogno di un consiglio professionale?"}</h2>
      <p>{page.cta?.text || "Prenota una consulenza e confrontati con una Farmacista specializzata in Fitoterapia per individuare la soluzione piu adatta alle tue esigenze."}</p>
      <a class="button booking-button" href={page.cta?.primaryLink || "/contatti"}>
        {page.cta?.primaryLabel || "Richiedi una consulenza"} <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
  </section>
</MainLayout>

<style>
  .phyto-hero {
    background:
      radial-gradient(circle at 12% 10%, rgba(197, 155, 39, 0.14), transparent 30%),
      linear-gradient(135deg, #fffdf8 0%, #fcfbf7 46%, #eef2ec 100%);
    padding: clamp(72px, 10vw, 132px) 0 clamp(56px, 8vw, 100px);
  }

  .phyto-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.42fr);
    gap: clamp(28px, 6vw, 78px);
    align-items: end;
  }

  .phyto-hero-copy {
    max-width: 820px;
  }

  .phyto-hero h1 {
    max-width: 900px;
    color: #13382b;
    font-size: clamp(2.15rem, 4.7vw, 3.85rem);
  }

  .phyto-primary {
    background: #c59b27;
    color: white;
  }

  .phyto-primary:hover,
  .booking-button:hover {
    background: #a8801d;
  }

  .phyto-note {
    border: 1px solid rgba(197, 155, 39, 0.2);
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 24px 70px rgba(46, 58, 54, 0.1);
    padding: 28px;
  }

  .phyto-note span {
    display: inline-flex;
    margin-bottom: 18px;
    border-radius: 999px;
    background: rgba(197, 155, 39, 0.12);
    color: #9b7619;
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    padding: 8px 12px;
    text-transform: uppercase;
  }

  .phyto-note strong {
    display: block;
    color: #13382b;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.7rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .phyto-note p {
    margin: 16px 0 0;
  }

  .phyto-intro,
  .phyto-booking {
    background: #fcfbf7;
  }

  .split-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(34px, 6vw, 82px);
    align-items: start;
  }

  .split-panel h2,
  .service-panel h2,
  .expertise-grid h2,
  .booking-panel h2 {
    color: #13382b;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.06;
  }

  .split-copy {
    display: grid;
    gap: 18px;
    max-width: 700px;
  }

  .split-copy p,
  .expertise-grid p {
    color: #3d4e45;
    font-size: 1.04rem;
    line-height: 1.78;
    margin: 0;
  }

  .phyto-service {
    background: #fffdf8;
  }

  .service-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 34px;
    border: 1px solid rgba(197, 155, 39, 0.24);
    border-radius: 28px;
    background: #fff7df;
    padding: clamp(26px, 5vw, 48px);
  }

  .service-panel h2 {
    color: #4b3a15;
  }

  .service-columns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .service-columns article {
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.58);
    padding: 22px;
  }

  .service-columns h3 {
    color: #4b3a15;
    margin-bottom: 12px;
  }

  .service-columns ul {
    display: grid;
    gap: 11px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service-columns li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: #5d4b20;
    line-height: 1.55;
  }

  .service-columns svg {
    flex: 0 0 auto;
    color: #9b7619;
    margin-top: 4px;
  }

  .phyto-expertise {
    background: #fcfbf7;
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(22px, 4vw, 44px);
    align-items: center;
    max-width: 1040px;
  }

  .expertise-grid h2 {
    margin-bottom: 18px;
  }

  .expertise-grid p + p {
    margin-top: 14px;
  }

  .expertise-icon {
    display: grid;
    width: 68px;
    height: 68px;
    place-items: center;
    border-radius: 50%;
    background: rgba(197, 155, 39, 0.13);
    color: #9b7619;
  }

  .expertise-icon.secondary {
    background: rgba(120, 151, 124, 0.16);
    color: #13382b;
  }

  .booking-panel {
    max-width: 820px;
    border-radius: 30px;
    background: #13382b;
    color: white;
    box-shadow: 0 28px 80px rgba(19, 56, 43, 0.18);
    padding: clamp(34px, 6vw, 58px);
    text-align: center;
  }

  .booking-panel .eyebrow {
    color: #c59b27;
  }

  .booking-panel h2,
  .booking-panel p {
    margin-right: auto;
    margin-left: auto;
    color: white;
  }

  .booking-panel p {
    max-width: 650px;
    color: rgba(255, 255, 255, 0.78);
  }

  .booking-button {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-top: 12px;
    background: #c59b27;
    color: white;
  }

  @media (max-width: 980px) {
    .phyto-hero-inner,
    .split-panel,
    .service-panel,
    .service-columns,
    .expertise-grid {
      grid-template-columns: 1fr;
    }

    .expertise-icon.secondary {
      display: none;
    }
  }
</style>
