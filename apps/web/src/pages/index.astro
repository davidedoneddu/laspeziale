---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";
import CTASection from "../components/CTASection.astro";
import { getHomepage, getPrograms, getTestimonials } from "../lib/sanity";

const [homepage, programs, testimonials] = await Promise.all([
  getHomepage(),
  getPrograms(),
  getTestimonials(),
]);
const selectedPrograms = (homepage.featuredProgramSlugs || [])
  .map((slug) => programs.find((program) => program.slug === slug))
  .filter(Boolean);
const featuredPrograms = (selectedPrograms.length ? selectedPrograms : programs.filter((program) => program.isFeatured)).slice(0, 3);
const visibleFeaturedPrograms = featuredPrograms.length ? featuredPrograms : programs.slice(0, 3);
const clinicalProgramSlugs = new Set([
  "gestione-peso-ricomposizione-corporea",
  "gonfiore-disturbi-intestinali",
  "menopausa-premenopausa",
  "programma-anti-age",
  "nutrizione-sportiva",
]);
const helpPrograms = (programs.length ? programs : visibleFeaturedPrograms)
  .filter((program) => clinicalProgramSlugs.has(program.slug))
  .slice(0, 5);
const visibleHelpPrograms = helpPrograms.length ? helpPrograms : visibleFeaturedPrograms;
---

<MainLayout title={homepage.seo?.title} description={homepage.seo?.description}>
  <Hero
    title={homepage.heroTitle}
    subtitle={homepage.heroSubtitle}
    subheading="Quando il corpo cambia, serve un approccio diverso."
    imageUrl={homepage.heroImageUrl}
    eyebrow="Inizia il tuo viaggio"
    primaryHref={homepage.heroCtaLink || "/programmi"}
    primaryLabel={homepage.heroCtaLabel || "Scopri il percorso"}
    secondaryHref="/contatti"
    secondaryLabel="Contattaci"
    showActions={false}
  />

  <section class="studio-intro">
    <div class="studio-wordmark" aria-hidden="true">La Speziale</div>
    <div class="container intro-layout">
      <div class="intro-visual reveal reveal-image">
        <div
          class="intro-photo"
          style={homepage.approachImageUrl ? `--approach-image: url('${homepage.approachImageUrl}')` : undefined}
          role={homepage.approachImageUrl ? "img" : undefined}
          aria-label={homepage.approachImageUrl ? "Lo studio La Speziale e il suo approccio integrato" : undefined}
          aria-hidden={homepage.approachImageUrl ? undefined : "true"}
        ></div>
        <p class="intro-caption">Nutrizione personalizzata, consiglio fitoterapico e supporto al cambiamento lavorano insieme.</p>
      </div>
      <div class="intro-copy reveal">
        <p class="eyebrow">{homepage.introEyebrow}</p>
        <h2>{homepage.introTitle}</h2>
        <p class="intro-lead">{homepage.introLead}</p>
        <p class="intro-body">{homepage.introBody}</p>
      </div>
    </div>
  </section>

  <section class="method-paths">
    <div class="container method-layout">
      <header class="method-heading reveal">
        <p class="eyebrow">{homepage.methodEyebrow}</p>
        <h2>{homepage.methodTitle}</h2>
        <p>{homepage.methodText}</p>
      </header>

      <div class="method-board reveal">
        <section class="method-chapter method-chapter-core" aria-labelledby="core-pillars-title">
          <div class="method-chapter-head">
            <span>01</span>
            <div>
              <p class="eyebrow">{homepage.methodCoreEyebrow}</p>
              <h3 id="core-pillars-title">Tre professionalita. Un unico metodo.</h3>
            </div>
          </div>
          <div class="pillar-grid">
            <article>
              <span>01</span>
              <h4>Nutrizione personalizzata</h4>
              <p><strong>La Biologa Nutrizionista</strong> elabora un piano alimentare costruito sulla composizione corporea, sul metabolismo, sullo stile di vita e sugli obiettivi della persona, trasformando la nutrizione in uno strumento concreto e sostenibile.</p>
            </article>
            <article>
              <span>02</span>
              <h4>Il Consiglio Fitoterapico</h4>
              <p><strong>La Farmacista specializzata in Fitoterapia</strong> quando necessario, individua piante officinali e nutraceutici realmente adatti alla persona, valutando obiettivi, eventuali terapie farmacologiche e possibili interazioni.</p>
            </article>
            <article>
              <span>03</span>
              <h4>Consapevolezza del corpo</h4>
              <p><strong>Il Tutor del Benessere</strong> aiuta la persona a comprendere il linguaggio del proprio corpo, riconoscere i cambiamenti e trasformarli in nuove abitudini attraverso un percorso di maggiore consapevolezza.</p>
            </article>
          </div>
          <p class="method-note">{homepage.methodCoreText}</p>
          <a class="text-link" href="/il-metodo">
            {homepage.methodCoreLinkLabel} <span aria-hidden="true">-&gt;</span>
          </a>
        </section>

        <section class="method-chapter" aria-labelledby="core-areas-title">
          <div class="method-chapter-head">
            <span>02</span>
            <div>
              <p class="eyebrow">Come possiamo aiutarti</p>
              <h3 id="core-areas-title">{homepage.methodDietTitle}</h3>
            </div>
          </div>
          <p>{homepage.methodDietText}</p>
          <ul class="method-area-list">
            <li><strong>Gestione del peso e ricomposizione corporea</strong><span>Ritrovare la forma fisica significa ritrovare il proprio equilibrio.</span></li>
            <li><strong>Gonfiore e disturbi intestinali</strong><span>Quando l'intestino ritrova equilibrio, cambia anche il benessere quotidiano.</span></li>
            <li><strong>Le fasi della donna</strong><span>Il corpo della donna cambia molte volte nella vita.</span></li>
            <li><strong>Longevita e vitalita</strong><span>Gli anni passano. Il benessere puo continuare a crescere.</span></li>
            <li><strong>Nutrizione sportiva</strong><span>Allenarsi meglio significa nutrire meglio il proprio corpo.</span></li>
          </ul>
        </section>
      </div>
    </div>
  </section>

  <section class="program-experience" data-horizontal-programs>
    <div class="program-sticky">
      <div class="container program-heading reveal">
        <p class="eyebrow">Percorsi dedicati</p>
        <h2>Come possiamo aiutarti</h2>
        <p>Ogni persona ha esigenze diverse. Per questo abbiamo sviluppato percorsi dedicati ai principali bisogni che incontriamo ogni giorno nel nostro studio.</p>
      </div>
      <div class="program-viewport">
        <div class="program-track">
        {
          visibleHelpPrograms.map((program, index) => (
            <article class="program-card">
              <div class="program-image" style={`--program-image: url('${program.imageUrl || "/assets/old-site/hero-bright-wellbeing.png"}')`}>
                <span class="program-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              </div>
              <div class="program-copy">
                <p class="eyebrow">{program.category || "Percorso"}</p>
                <h3>{program.title}</h3>
                <p>{program.excerpt}</p>
                <a class="text-link" href={`/programmi/${program.slug}`}>Scopri il percorso <span aria-hidden="true">-&gt;</span></a>
              </div>
            </article>
          ))
        }
          <aside class="program-end">
            <p class="eyebrow">Il tuo percorso inizia da qui</p>
            <h3>Ascolteremo la tua storia e valuteremo le tue esigenze.</h3>
            <div class="button-row">
              <a class="button button-primary" href="/contatti">Richiedi una consulenza</a>
              <a class="button button-secondary" href="/programmi">Tutti i programmi</a>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <section class="autonomous-services">
    <div class="container">
      <section class="method-chapter" aria-labelledby="satellite-services-title">
        <div class="method-chapter-head">
          <span>03</span>
          <div>
            <p class="eyebrow">{homepage.methodPhytoLabel}</p>
            <h3 id="satellite-services-title">{homepage.methodPhytoTitle}</h3>
          </div>
        </div>
        <p>{homepage.methodPhytoText}</p>
        <div class="satellite-grid">
          <article>
            <h4>Il Consiglio Fitoterapico</h4>
            <p><strong>Con la Farmacista specializzata in Fitoterapia.</strong> Una consulenza professionale per individuare, quando necessario, piante officinali e nutraceutici realmente adatti alle tue esigenze.</p>
            <a class="text-link" href="/fitoterapia">Scopri il Consiglio Fitoterapico <span aria-hidden="true">-&gt;</span></a>
          </article>
          <article>
            <h4>La Consulenza di Consapevolezza</h4>
            <p><strong>Con il Tutor del Benessere.</strong> Una consulenza dedicata a comprendere il linguaggio del proprio corpo, riconoscere i cambiamenti e affrontare ogni fase della vita con maggiore consapevolezza.</p>
            <a class="text-link" href="/consapevolezza">Scopri la Consulenza di Consapevolezza <span aria-hidden="true">-&gt;</span></a>
          </article>
        </div>
      </section>
    </div>
  </section>

  <section class="voices-section">
    <div class="container voices-layout">
      <header class="voices-heading reveal">
        <p class="eyebrow">Dicono di noi</p>
        <h2>Il cambiamento si misura anche nel modo in cui ci si sente.</h2>
        <a class="text-link" href="/dicono-di-noi">Leggi tutte le esperienze <span aria-hidden="true">→</span></a>
      </header>
      <div class="voices-list">
        {testimonials.slice(0, 3).map((item, index) => (
          <figure class="voice reveal" style={`--delay: ${index * 100}ms`}>
            <blockquote>“{item.text}”</blockquote>
            <figcaption>
              <strong>{item.name}</strong>
              {item.role && <span>{item.role}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <CTASection {...homepage.finalCta} immersive />
</MainLayout>

<script>
  const revealItems = document.querySelectorAll(".reveal");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const horizontalSection = document.querySelector<HTMLElement>("[data-horizontal-programs]");
  const horizontalTrack = horizontalSection?.querySelector<HTMLElement>(".program-track");
  const horizontalViewport = horizontalSection?.querySelector<HTMLElement>(".program-viewport");

  if (reduceMotion || !("IntersectionObserver" in window)) {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  } else {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.18 },
    );
    revealItems.forEach((item) => revealObserver.observe(item));
  }

  if (!reduceMotion && horizontalSection && horizontalTrack && horizontalViewport) {
    let horizontalFrame = 0;
    let horizontalActive = false;

    const updateProgramTravel = () => {
      const isDesktop = window.matchMedia("(min-width: 901px)").matches;
      if (!isDesktop) {
        horizontalSection.style.removeProperty("--program-travel");
        horizontalSection.style.removeProperty("--program-scroll-height");
        horizontalTrack.style.removeProperty("transform");
        return;
      }

      const travel = Math.max(0, horizontalTrack.scrollWidth - horizontalViewport.clientWidth);
      horizontalSection.style.setProperty("--program-travel", `${travel}`);
      horizontalSection.style.setProperty("--program-scroll-height", `${Math.max(1200, travel + window.innerHeight)}px`);
    };

    const renderProgramPosition = () => {
      if (!horizontalActive) return;

      const sectionRect = horizontalSection.getBoundingClientRect();
      const stickyHeight = horizontalSection.querySelector<HTMLElement>(".program-sticky")?.offsetHeight || window.innerHeight;
      const travel = Number.parseFloat(horizontalSection.style.getPropertyValue("--program-travel")) || 0;
      const stickyTop = 76;
      const scrollableDistance = Math.max(1, sectionRect.height - stickyHeight);
      const progress = Math.min(1, Math.max(0, (stickyTop - sectionRect.top) / scrollableDistance));
      horizontalTrack.style.transform = `translate3d(${-travel * progress}px, 0, 0)`;
      horizontalFrame = window.requestAnimationFrame(renderProgramPosition);
    };

    const horizontalResizeObserver = new ResizeObserver(updateProgramTravel);
    horizontalResizeObserver.observe(horizontalTrack);
    horizontalResizeObserver.observe(horizontalViewport);

    const horizontalIntersectionObserver = new IntersectionObserver((entries) => {
      const entry = entries[0];
      horizontalActive = Boolean(entry?.isIntersecting && window.matchMedia("(min-width: 901px)").matches);
      window.cancelAnimationFrame(horizontalFrame);
      if (horizontalActive) horizontalFrame = window.requestAnimationFrame(renderProgramPosition);
    });
    horizontalIntersectionObserver.observe(horizontalSection);
    updateProgramTravel();
  }
</script>

<style>
  .studio-intro {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(88px, 11vw, 156px) 0 88px;
    background:
      radial-gradient(circle at 8% 10%, rgba(197, 155, 39, 0.12), transparent 28%),
      linear-gradient(145deg, rgba(120, 151, 124, 0.16), transparent 42%),
      var(--color-white);
  }

  .studio-wordmark {
    position: absolute;
    top: 20px;
    right: -0.04em;
    z-index: -1;
    color: rgba(93, 120, 95, 0.055);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(4.5rem, 13vw, 11rem);
    line-height: 0.8;
    white-space: nowrap;
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: clamp(48px, 8vw, 112px);
    align-items: center;
  }

  .intro-visual {
    position: relative;
    padding: 0 0 46px 36px;
  }

  .intro-visual::before {
    position: absolute;
    inset: 36px 36px 0 0;
    z-index: -1;
    background: #dbe3d8;
    content: "";
  }

  .intro-photo {
    min-height: 580px;
    background:
      linear-gradient(rgba(16, 24, 20, 0.03), rgba(16, 24, 20, 0.08)),
      var(--approach-image, linear-gradient(135deg, #e8eadf 0%, #fff7df 42%, #78977c 100%));
    background-position: center;
    background-size: cover;
    box-shadow: 0 28px 70px rgba(38, 51, 44, 0.16);
  }

  .intro-caption {
    position: absolute;
    right: -28px;
    bottom: 0;
    width: min(280px, 76%);
    margin: 0;
    padding: 20px 24px;
    background: var(--color-ink);
    color: white;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.05rem;
    line-height: 1.45;
  }

  .intro-copy h2 {
    max-width: 740px;
    margin-bottom: 28px;
    font-size: clamp(2.05rem, 4.1vw, 3.75rem);
  }

  .intro-lead {
    max-width: 660px;
    margin-bottom: 22px;
    color: var(--color-ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    line-height: 1.5;
  }

  .intro-body {
    max-width: 680px;
    margin-bottom: 30px;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .text-link {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    border-bottom: 1px solid rgba(38, 51, 44, 0.35);
    padding-bottom: 5px;
    font-weight: 800;
  }

  .text-link span {
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .text-link:hover span {
    transform: translateX(5px);
  }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    filter: blur(4px);
    transition:
      opacity 720ms cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms),
      filter 720ms cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms);
  }

  .reveal-image {
    transform: translateY(30px);
    clip-path: inset(0 0 18% 0);
    transition:
      opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 900ms cubic-bezier(0.22, 1, 0.36, 1),
      clip-path 1.1s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    clip-path: inset(0);
  }

  .program-experience {
    --program-travel: 0;
    height: var(--program-scroll-height, 1800px);
    view-timeline-name: --program-section;
    view-timeline-axis: block;
    background:
      radial-gradient(circle at 10% 0%, rgba(197, 155, 39, 0.16), transparent 34%),
      #e8eadf;
  }

  .program-sticky {
    position: sticky;
    top: 76px;
    display: grid;
    min-height: calc(100dvh - 76px);
    align-content: center;
    overflow: hidden;
    padding: 28px 0 22px;
  }

  .program-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.6fr);
    gap: 36px;
    align-items: end;
    margin-bottom: 20px;
  }

  .program-heading .eyebrow {
    grid-column: 1 / -1;
    margin-bottom: -18px;
  }

  .program-heading h2 {
    margin: 0;
    font-size: clamp(2.05rem, 3.8vw, 3.45rem);
  }

  .program-heading > p:last-child {
    margin: 0 0 8px;
    font-size: 1.05rem;
  }

  .program-viewport {
    width: 100%;
    overflow: hidden;
  }

  .program-track {
    display: flex;
    width: max-content;
    gap: 30px;
    padding: 0 max(20px, calc((100vw - 1120px) / 2)) 22px;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .program-card {
    display: grid;
    width: min(84vw, 1040px);
    min-height: 360px;
    grid-template-columns: minmax(360px, 1.05fr) minmax(360px, 0.95fr);
    overflow: hidden;
    background: var(--color-white);
    box-shadow: 0 24px 70px rgba(38, 51, 44, 0.12);
  }

  .program-image {
    position: relative;
    min-height: 360px;
    background-image: linear-gradient(rgba(16, 24, 20, 0.03), rgba(16, 24, 20, 0.12)), var(--program-image);
    background-position: center;
    background-size: cover;
  }

  .program-index {
    position: absolute;
    top: 24px;
    left: 24px;
    color: white;
    font-size: 0.8rem;
    font-weight: 800;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.3);
  }

  .program-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(32px, 4vw, 58px);
  }

  .program-copy h3 {
    overflow-wrap: anywhere;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.75rem, 2.55vw, 2.65rem);
    font-weight: 500;
    hyphens: auto;
    line-height: 1.08;
  }

  .program-end h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 500;
    line-height: 1.08;
  }

  .program-copy > p:not(.eyebrow) {
    margin-bottom: 28px;
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .program-copy .text-link {
    align-self: flex-start;
  }

  .program-end {
    display: flex;
    width: min(60vw, 650px);
    min-height: 360px;
    flex-direction: column;
    justify-content: center;
    background: var(--color-ink);
    color: white;
    padding: clamp(40px, 6vw, 74px);
  }

  .program-end .eyebrow,
  .program-end h3 {
    color: white;
  }

  .program-end .button-primary {
    background: white;
    color: var(--color-ink);
  }

  .program-end .button-secondary {
    border-color: rgba(255, 255, 255, 0.48);
    background: transparent;
    color: white;
  }

  .method-paths {
    position: relative;
    overflow: hidden;
    padding: clamp(86px, 11vw, 156px) 0;
    background:
      radial-gradient(circle at 12% 16%, rgba(197, 155, 39, 0.12), transparent 30%),
      radial-gradient(circle at 88% 76%, rgba(120, 151, 124, 0.18), transparent 28%),
      linear-gradient(180deg, var(--color-ivory) 0%, var(--color-white) 100%);
  }

  .method-paths::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(38, 51, 44, 0.045) 1px, transparent 1px),
      linear-gradient(rgba(38, 51, 44, 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    content: "";
    mask-image: radial-gradient(circle at 50% 42%, black 0%, transparent 68%);
    pointer-events: none;
  }

  .method-layout {
    position: relative;
  }

  .method-heading {
    max-width: 820px;
    margin: 0 auto clamp(42px, 7vw, 76px);
    text-align: center;
  }

  .method-heading h2 {
    margin-bottom: 22px;
    font-size: clamp(2.05rem, 4.2vw, 3.85rem);
  }

  .method-heading p:last-child {
    max-width: 720px;
    margin: 0 auto;
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.8;
  }

  .method-board {
    display: grid;
    gap: 22px;
  }

  .method-chapter {
    border: 1px solid rgba(38, 51, 44, 0.13);
    background: rgba(255, 255, 255, 0.86);
    padding: clamp(24px, 4.5vw, 48px);
    box-shadow: 0 24px 70px rgba(38, 51, 44, 0.08);
  }

  .method-chapter-core {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(228, 235, 225, 0.72)),
      var(--color-white);
  }

  .method-chapter-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    margin-bottom: 28px;
  }

  .method-chapter-head > span {
    display: grid;
    width: 46px;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid rgba(93, 120, 95, 0.24);
    background: rgba(143, 165, 143, 0.14);
    color: var(--color-sage-dark);
    font-weight: 850;
  }

  .method-chapter h3 {
    max-width: 760px;
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.75rem, 3.2vw, 2.85rem);
    font-weight: 500;
  }

  .method-chapter > p,
  .method-note {
    max-width: 760px;
    margin: 0 0 24px;
    font-size: 1.03rem;
    line-height: 1.78;
  }

  .pillar-grid,
  .satellite-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 26px;
  }

  .pillar-grid article,
  .satellite-grid article {
    border: 1px solid rgba(38, 51, 44, 0.1);
    background: rgba(255, 255, 255, 0.78);
    padding: 24px;
  }

  .pillar-grid article {
    min-height: 210px;
  }

  .pillar-grid span {
    display: block;
    margin-bottom: 18px;
    color: var(--color-gold);
    font-weight: 850;
  }

  .pillar-grid h4,
  .satellite-grid h4 {
