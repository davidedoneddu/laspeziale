---
import MainLayout from "../layouts/MainLayout.astro";
import Hero from "../components/Hero.astro";
import CTASection from "../components/CTASection.astro";
import { getHomepage, getPrograms } from "../lib/sanity";
import { imageSrcSet, optimizedImageUrl } from "../lib/images";

const [homepage, programs] = await Promise.all([
  getHomepage(),
  getPrograms(),
]);
const homeProgramContent = [
  {
    slug: "gestione-peso-ricomposizione-corporea",
    title: "Gestione del peso, cellulite e ricomposizione corporea",
    highlight: "Ritrovare la forma fisica significa ritrovare il proprio equilibrio.",
    text: "Un percorso personalizzato per ridurre la massa grassa, migliorare la composizione corporea e valorizzare la silhouette, senza rinunce e con risultati duraturi.",
  },
  {
    slug: "gonfiore-disturbi-intestinali",
    title: "Gonfiore e disturbi intestinali",
    highlight: "Quando l'intestino ritrova equilibrio, cambia anche il benessere quotidiano.",
    text: "Un percorso dedicato a digestione, gonfiore e funzionalità intestinale per aiutare l'organismo a ritrovare regolarità e leggerezza.",
  },
  {
    slug: "menopausa-premenopausa",
    title: "Le fasi della donna",
    highlight: "Il corpo della donna cambia molte volte nella vita.",
    text: "PCOS, endometriosi, ciclo irregolare, fertilità, premenopausa e menopausa: un percorso che accompagna il corpo nelle diverse fasi della vita, adattandosi ai suoi nuovi bisogni.",
  },
  {
    slug: "programma-anti-age",
    title: "Longevità e vitalità",
    highlight: "L'età cambia. Il benessere può continuare a crescere.",
    text: "Un percorso dedicato a mantenere energia, forza, tono muscolare e vitalità, per vivere ogni fase della vita con maggiore equilibrio.",
  },
  {
    slug: "nutrizione-sportiva",
    title: "Nutrizione sportiva",
    highlight: "Allenarsi meglio significa nutrirsi meglio.",
    text: "Un'alimentazione personalizzata per migliorare composizione corporea, recupero ed energia, sostenendo ogni obiettivo sportivo.",
  },
];
const visibleHelpPrograms = homeProgramContent.map((content) => ({
  ...content,
  program: programs.find((program) => program.slug === content.slug),
}));
const approachImage = homepage.approachImageUrl || "/assets/old-site/home-metodo-competenze.png";
const phytoImage = homepage.methodPhytoImageUrl || "/assets/old-site/fitoterapia-consulenza-2026.jpg";
const coachingImage = homepage.methodCoachingImageUrl || "/assets/old-site/consapevolezza-2026.jpg";
---

<MainLayout title={homepage.seo?.title} description={homepage.seo?.description}>
  <Hero
    title={homepage.heroTitle}
    subtitle={homepage.heroSubtitle}
    subheading="Quando il corpo cambia, serve un approccio diverso."
    imageUrl={homepage.heroImageUrl}
    primaryHref={homepage.heroCtaLink || "/programmi"}
    primaryLabel={homepage.heroCtaLabel || "Scopri il percorso"}
    secondaryHref="/contatti"
    secondaryLabel="Contattaci"
    showActions={false}
  />

  <section class="studio-intro">
    <div class="container intro-layout">
      <div class="intro-visual reveal reveal-image">
        <img
          class="intro-photo"
          src={optimizedImageUrl(approachImage, 1200)}
          srcset={imageSrcSet(approachImage, [640, 960, 1200, 1440])}
          sizes="(max-width: 900px) 560px, 52vw"
          alt="Tre professionisti collaborano alla costruzione del Metodo La Speziale"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="intro-copy reveal">
        <h2>{homepage.introEyebrow || "Perché un approccio diverso"}</h2>
        <p class="section-subtitle">{homepage.introTitle}</p>
        <div class="section-body">
          <p>{homepage.introLead}</p>
          {homepage.introBody.split(/\n+/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <section class="studio-space">
    <div class="container studio-space-inner reveal">
      <div class="studio-space-heading">
        <h2>Anche lo spazio fa parte del percorso.</h2>
        <p>Sentirsi accolti cambia il modo di iniziare.</p>
      </div>
      <p class="studio-space-text">
        Fuori, il ritmo veloce di Milano. Dentro, un luogo raccolto dove il tempo rallenta e l’attenzione torna sulla persona. Intorno, oggetti e dettagli raccontano l’antica arte dello Speziale, da cui nasce il nostro nome, reinterpretata oggi nel nostro modo di accogliere e lavorare.
      </p>
    </div>
  </section>

  <section class="method-paths">
    <div class="container method-layout">
      <header class="method-heading reveal">
        <h2>{homepage.methodEyebrow || "Un percorso, tre competenze"}</h2>
        <p class="section-subtitle">{homepage.methodTitle}</p>
        <div class="method-body">{homepage.methodText.split(/\n+/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}</div>
      </header>

      <div class="method-board reveal">
        <section class="method-chapter method-chapter-core" aria-labelledby="core-pillars-title">
          <div class="method-chapter-head">
            <div>
              <h2 id="core-pillars-title">{homepage.methodCoreEyebrow || "Lavorare insieme fa la differenza"}</h2>
              <p class="chapter-subtitle">Tre professionalità. Un unico metodo.</p>
            </div>
          </div>
          <div class="pillar-grid">
            <article>
              <h3>Nutrizione personalizzata</h3>
              <p class="role">La Biologa Nutrizionista</p>
              <p>Costruisce un piano alimentare personalizzato partendo dalla composizione corporea, dal metabolismo e dalle esigenze della persona, con un approccio concreto e facilmente applicabile nella vita quotidiana.</p>
            </article>
            <article>
              <h3>Consiglio fitoterapico</h3>
              <p class="role">La Farmacista specializzata in Fitoterapia</p>
              <p>Valuta quando piante officinali e nutraceutici possono rappresentare un supporto utile, individuando le soluzioni più adatte in base alla situazione e agli obiettivi della persona.</p>
            </article>
            <article>
              <h3>Supporto al cambiamento</h3>
              <p class="role">Il Tutor del Benessere</p>
              <p>Accompagna la persona nello sviluppo di nuove abitudini, aiutandola a comprendere i cambiamenti del proprio corpo e a viverli con maggiore consapevolezza.</p>
            </article>
          </div>
        </section>

      </div>
    </div>
  </section>

  <section class="program-experience" data-horizontal-programs>
    <div class="program-sticky">
      <div class="container program-heading reveal">
        <h2>Come possiamo aiutarti</h2>
        <div>
          <p class="section-subtitle">Ogni cambiamento del corpo richiede attenzioni diverse.</p>
          <p>Per questo abbiamo sviluppato percorsi dedicati ai principali bisogni che incontriamo ogni giorno nel nostro studio.</p>
        </div>
      </div>
      <div class="program-viewport">
        <div class="program-track">
        {
          visibleHelpPrograms.map(({ program, ...content }) => (
            <article class="program-card">
              <div class="program-image" style={`--program-image: url('${program?.imageUrl || "/assets/old-site/hero-bright-wellbeing.png"}')`}></div>
              <div class="program-copy">
                <h3>{content.title}</h3>
                <p class="card-highlight">{content.highlight}</p>
                <p>{content.text}</p>
                <a class="text-link" href={`/programmi/${content.slug}`}>Scopri il percorso</a>
              </div>
            </article>
          ))
        }
        </div>
      </div>
    </div>
  </section>

  <section class="autonomous-services">
    <div class="container">
      <section class="method-chapter" aria-labelledby="satellite-services-title">
        <div class="method-chapter-head">
          <div>
            <h2 id="satellite-services-title">Consulenze autonome</h2>
            <p class="chapter-subtitle">{homepage.methodPhytoTitle}</p>
          </div>
        </div>
        <div class="section-body">{homepage.methodPhytoText.split(/\n+/).filter(Boolean).map((paragraph) => <p>{paragraph}</p>)}</div>
        <div class="satellite-grid">
          <article class="satellite-card">
            <img
              class="satellite-image"
              src={optimizedImageUrl(phytoImage, 900)}
              srcset={imageSrcSet(phytoImage, [480, 720, 900, 1200])}
              sizes="(max-width: 900px) calc(100vw - 40px), 50vw"
              alt="Piante officinali e preparazioni per il Consiglio Fitoterapico"
              loading="lazy"
              decoding="async"
            />
            <div class="satellite-copy">
              <h3>Il Consiglio Fitoterapico</h3>
              <p class="role">Con la Farmacista specializzata in Fitoterapia</p>
              <p>Una consulenza professionale per individuare, quando necessario, piante officinali e nutraceutici realmente adatti alle tue esigenze.</p>
              <a class="text-link" href="/fitoterapia">Scopri il Consiglio Fitoterapico</a>
            </div>
          </article>
          <article class="satellite-card">
            <img
              class="satellite-image"
              src={optimizedImageUrl(coachingImage, 900)}
              srcset={imageSrcSet(coachingImage, [480, 720, 900, 1200])}
              sizes="(max-width: 900px) calc(100vw - 40px), 50vw"
              alt="Percorso verso una maggiore consapevolezza"
              loading="lazy"
              decoding="async"
            />
            <div class="satellite-copy">
              <h3>La Consulenza di Consapevolezza</h3>
              <p class="role">Con il Tutor del Benessere</p>
              <p>Una consulenza dedicata a comprendere i cambiamenti del proprio corpo, sviluppare nuove abitudini e affrontare ogni fase con maggiore consapevolezza.</p>
              <a class="text-link" href="/consapevolezza">Scopri la Consulenza di Consapevolezza</a>
            </div>
          </article>
        </div>
      </section>
    </div>
  </section>

  <CTASection {...homepage.finalCta} secondaryLabel="" titleAsHeading={false} immersive />
</MainLayout>

<script>
  const revealItems = document.querySelectorAll(".reveal");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const horizontalSection = document.querySelector<HTMLElement>("[data-horizontal-programs]");
  const horizontalTrack = horizontalSection?.querySelector<HTMLElement>(".program-track");
  const horizontalViewport = horizontalSection?.querySelector<HTMLElement>(".program-viewport");

  if (reduceMotion || !("IntersectionObserver" in window)) {
    revealItems.forEach((item) => item.classList.add("is-visible"));
  } else {
    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.18 },
    );
    revealItems.forEach((item) => revealObserver.observe(item));
  }

  if (!reduceMotion && horizontalSection && horizontalTrack && horizontalViewport) {
    let horizontalFrame = 0;
    let horizontalActive = false;

    const updateProgramTravel = () => {
      const isDesktop = window.matchMedia("(min-width: 901px)").matches;
      if (!isDesktop) {
        horizontalSection.style.removeProperty("--program-travel");
        horizontalSection.style.removeProperty("--program-scroll-height");
        horizontalTrack.style.removeProperty("transform");
        return;
      }

      const travel = Math.max(0, horizontalTrack.scrollWidth - horizontalViewport.clientWidth);
      horizontalSection.style.setProperty("--program-travel", `${travel}`);
      horizontalSection.style.setProperty("--program-scroll-height", `${Math.max(1200, travel + window.innerHeight)}px`);
    };

    const renderProgramPosition = () => {
      if (!horizontalActive) return;

      const sectionRect = horizontalSection.getBoundingClientRect();
      const stickyHeight = horizontalSection.querySelector<HTMLElement>(".program-sticky")?.offsetHeight || window.innerHeight;
      const travel = Number.parseFloat(horizontalSection.style.getPropertyValue("--program-travel")) || 0;
      const stickyTop = 76;
      const scrollableDistance = Math.max(1, sectionRect.height - stickyHeight);
      const progress = Math.min(1, Math.max(0, (stickyTop - sectionRect.top) / scrollableDistance));
      horizontalTrack.style.transform = `translate3d(${-travel * progress}px, 0, 0)`;
      horizontalFrame = window.requestAnimationFrame(renderProgramPosition);
    };

    const horizontalResizeObserver = new ResizeObserver(updateProgramTravel);
    horizontalResizeObserver.observe(horizontalTrack);
    horizontalResizeObserver.observe(horizontalViewport);

    const horizontalIntersectionObserver = new IntersectionObserver((entries) => {
      const entry = entries[0];
      horizontalActive = Boolean(entry?.isIntersecting && window.matchMedia("(min-width: 901px)").matches);
      window.cancelAnimationFrame(horizontalFrame);
      if (horizontalActive) horizontalFrame = window.requestAnimationFrame(renderProgramPosition);
    });
    horizontalIntersectionObserver.observe(horizontalSection);
    updateProgramTravel();
  }
</script>

<style>
  .studio-intro {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(64px, 7vw, 88px) 0 64px;
    background:
      radial-gradient(circle at 8% 10%, rgba(197, 155, 39, 0.12), transparent 28%),
      linear-gradient(145deg, rgba(120, 151, 124, 0.16), transparent 42%),
      var(--color-white);
  }

  .intro-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(48px, 6vw, 88px);
    align-items: center;
  }

  .intro-visual {
    position: relative;
    padding: 28px;
    background: #dbe3d8;
  }

  .intro-photo {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    box-shadow: 0 28px 70px rgba(38, 51, 44, 0.16);
  }

  .intro-copy h2,
  .method-heading h2,
  .method-chapter h2,
  .program-heading h2 {
    max-width: 740px;
    margin-bottom: 18px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(2.05rem, 4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.08;
  }

  .section-subtitle {
    max-width: 660px;
    margin: 0 0 22px;
    color: var(--color-ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 2.2vw, 1.65rem);
    line-height: 1.5;
  }

  .section-body {
    max-width: 680px;
  }

  .section-body p {
    margin: 0 0 20px;
    font-size: 1.03rem;
    line-height: 1.85;
  }

  .section-body p:last-child {
    margin-bottom: 0;
  }

  .studio-space {
    border-top: 1px solid rgba(19, 56, 43, 0.08);
    border-bottom: 1px solid rgba(19, 56, 43, 0.08);
    background: #e8eadf;
    color: var(--color-primary);
    padding: clamp(30px, 4vw, 42px) 0;
  }

  .studio-space-inner {
    display: grid;
    grid-template-columns: minmax(260px, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }

  .studio-space-heading {
    border-right: 1px solid rgba(19, 56, 43, 0.16);
    padding-right: clamp(26px, 4vw, 46px);
  }

  .studio-space h2 {
    max-width: 470px;
    margin-bottom: 10px;
    color: var(--color-primary);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.85rem, 3vw, 2.55rem);
    font-weight: 500;
    line-height: 1.08;
  }

  .studio-space-heading p {
    margin: 0;
    color: var(--color-primary);
    font-size: 1.02rem;
    font-weight: 800;
    line-height: 1.5;
  }

  .studio-space-text {
    max-width: 780px;
    margin: 0;
    color: var(--color-ink);
    font-size: 1rem;
    line-height: 1.78;
  }

  .method-body {
    max-width: 720px;
    margin: 0;
  }

  .method-body p {
    margin: 0 0 20px;
    font-size: 1.03rem;
    line-height: 1.8;
  }

  .method-body p:last-child {
    margin-bottom: 0;
  }

  .text-link {
    display: inline-flex;
    gap: 12px;
    align-items: center;
    border-bottom: 1px solid rgba(38, 51, 44, 0.35);
    padding-bottom: 5px;
    font-weight: 800;
  }

  .text-link span {
    transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .text-link:hover span {
    transform: translateX(5px);
  }

  .reveal {
    opacity: 0;
    transform: translateY(24px);
    filter: blur(4px);
    transition:
      opacity 720ms cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms),
      transform 720ms cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms),
      filter 720ms cubic-bezier(0.22, 1, 0.36, 1) var(--delay, 0ms);
  }

  .reveal-image {
    transform: translateY(30px);
    clip-path: inset(0 0 18% 0);
    transition:
      opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 900ms cubic-bezier(0.22, 1, 0.36, 1),
      clip-path 1.1s cubic-bezier(0.77, 0, 0.175, 1);
  }

  .reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
    clip-path: inset(0);
  }

  .program-experience {
    --program-travel: 0;
    height: var(--program-scroll-height, 1800px);
    view-timeline-name: --program-section;
    view-timeline-axis: block;
    background:
      radial-gradient(circle at 10% 0%, rgba(197, 155, 39, 0.16), transparent 34%),
      #e8eadf;
  }

  .program-sticky {
    position: sticky;
    top: 76px;
    display: grid;
    min-height: calc(100dvh - 76px);
    align-content: center;
    overflow: hidden;
    padding: 28px 0 22px;
  }

  .program-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    align-items: start;
    max-width: 900px;
    margin-bottom: 32px;
  }

  .program-heading h2 {
    margin: 0;
  }

  .program-heading > div > p:last-child {
    max-width: 720px;
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .program-heading .section-subtitle {
    max-width: 720px;
    margin-bottom: 10px;
    font-size: clamp(1.18rem, 1.8vw, 1.45rem);
  }

  .program-viewport {
    width: 100%;
    overflow: hidden;
  }

  .program-track {
    display: flex;
    width: max-content;
    gap: 30px;
    padding: 0 max(20px, calc((100vw - 1120px) / 2)) 22px;
    transform: translate3d(0, 0, 0);
    will-change: transform;
  }

  .program-card {
    display: grid;
    width: min(84vw, 1040px);
    min-height: 360px;
    grid-template-columns: minmax(360px, 1.05fr) minmax(360px, 0.95fr);
    align-items: center;
    overflow: hidden;
    background: var(--color-white);
    box-shadow: 0 24px 70px rgba(38, 51, 44, 0.12);
  }

  .program-image {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 2;
    align-self: center;
    min-height: 0;
    background-image: linear-gradient(rgba(16, 24, 20, 0.03), rgba(16, 24, 20, 0.12)), var(--program-image);
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100% 100%, contain;
    background-color: #eef2ec;
  }

  .program-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(32px, 4vw, 58px);
  }

  .program-copy h3,
  .pillar-grid h3,
  .satellite-grid h3 {
    margin: 0 0 16px;
    overflow-wrap: anywhere;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.45rem, 2.1vw, 2rem);
    font-weight: 500;
    hyphens: auto;
    line-height: 1.18;
  }

  .program-copy > p {
    margin: 0 0 20px;
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .program-copy .card-highlight {
    color: var(--color-ink);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.08rem, 1.6vw, 1.3rem);
    font-weight: 700;
    line-height: 1.4;
  }

  .program-copy .text-link {
    align-self: flex-start;
  }

  .autonomous-services {
    background: #e8eadf;
    padding: clamp(48px, 5vw, 64px) 0;
  }

  .autonomous-services .method-chapter {
    border: 0;
    background: transparent;
    box-shadow: none;
    padding: 0;
  }

  .method-paths {
    position: relative;
    overflow: hidden;
    padding: clamp(48px, 5vw, 64px) 0;
    background:
      radial-gradient(circle at 12% 16%, rgba(197, 155, 39, 0.12), transparent 30%),
      radial-gradient(circle at 88% 76%, rgba(120, 151, 124, 0.18), transparent 28%),
      linear-gradient(180deg, var(--color-ivory) 0%, var(--color-white) 100%);
  }

  .method-paths::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(38, 51, 44, 0.045) 1px, transparent 1px),
      linear-gradient(rgba(38, 51, 44, 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    content: "";
    mask-image: radial-gradient(circle at 50% 42%, black 0%, transparent 68%);
    pointer-events: none;
  }

  .method-layout {
    position: relative;
  }

  .method-heading {
    max-width: 820px;
    margin: 0 0 clamp(42px, 7vw, 76px);
    text-align: left;
  }

  .method-heading .section-subtitle {
    max-width: 720px;
  }

  .method-board {
    display: grid;
    gap: 22px;
  }

  .method-chapter {
    border: 1px solid rgba(38, 51, 44, 0.13);
    background: rgba(255, 255, 255, 0.86);
    padding: clamp(24px, 4.5vw, 48px);
    box-shadow: 0 24px 70px rgba(38, 51, 44, 0.08);
  }

  .method-chapter-core {
    background:
      linear-gradient(135deg, rgba(255, 255, 255, 0.92), rgba(228, 235, 225, 0.72)),
      var(--color-white);
  }

  .method-chapter-head {
    margin-bottom: 28px;
  }

  .chapter-subtitle {
    max-width: 760px;
    margin: 12px 0 0;
    color: #244D3D;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.45;
  }

  .method-chapter > p,
  .method-chapter > .section-body {
    max-width: 760px;
    margin: 0 0 24px;
  }

  .pillar-grid,
  .satellite-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 26px;
  }

  .pillar-grid article,
  .satellite-grid article {
    border: 1px solid rgba(38, 51, 44, 0.1);
    background: rgba(255, 255, 255, 0.78);
    padding: 24px;
  }

  .pillar-grid article {
    min-height: 210px;
  }

  .pillar-grid p,
  .satellite-grid p {
    margin: 0;
    line-height: 1.68;
  }

  .pillar-grid .role,
  .satellite-grid .role {
    margin: 0 0 12px;
    color: var(--color-ink);
