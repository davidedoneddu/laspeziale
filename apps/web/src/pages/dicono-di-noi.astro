---
import { ExternalLink, Star } from "@lucide/astro";
import MainLayout from "../layouts/MainLayout.astro";
import CTASection from "../components/CTASection.astro";
import { getTestimonialsPage } from "../lib/sanity";

const page = await getTestimonialsPage();
const googleReviews = page.googleReviews || [];
const googleRating = Math.min(5, Math.max(0, page.googleRating || 0));
const googleReviewsUrl = page.googleReviewsUrl || "https://www.google.com/maps/search/?api=1&query=La+Speziale+Milano";
const formatReviewDate = (value?: string) => {
  if (!value) return undefined;
  return new Intl.DateTimeFormat("it-IT", { month: "long", year: "numeric" }).format(new Date(`${value}T12:00:00`));
};
---

<MainLayout title={page.seo?.title} description={page.seo?.description || page.heroText} image={page.seo?.imageUrl || page.heroImageUrl}>
  <section class:list={["page-hero", "testimonials-page-hero", { "testimonials-hero": page.heroImageUrl }]} style={page.heroImageUrl ? `--testimonials-hero: url('${page.heroImageUrl}')` : undefined}>
    <span class="hero-quote hero-quote-open" aria-hidden="true">“</span>
    <span class="hero-quote hero-quote-close" aria-hidden="true">”</span>
    <div class="container">
      <h1>{page.heroTitle}</h1>
      {page.heroText && <p class="lead">{page.heroText}</p>}
    </div>
  </section>

  {page.showGoogleReviews && (
    <section class="google-reviews-section" aria-labelledby="google-reviews-title">
      <div class="container google-reviews-panel">
        <div class="google-summary">
          <h2 id="google-reviews-title">{page.googleEyebrow || "Recensioni Google"}</h2>
          <p class="google-subtitle">{page.googleTitle || "Le recensioni pubblicate su Google"}</p>
          {page.googleText && <p class="google-intro">{page.googleText}</p>}
          {(googleRating > 0 || page.googleReviewCount) && (
            <div class="rating-summary">
              {googleRating > 0 && <strong>{googleRating.toLocaleString("it-IT", { maximumFractionDigits: 1 })}</strong>}
              {googleRating > 0 && (
                <span class="stars" aria-label={`Valutazione media ${googleRating} su 5`}>
                  {Array.from({ length: 5 }).map((_, index) => (
                    <Star size={18} stroke-width={1.8} class:list={{ filled: index < Math.round(googleRating) }} aria-hidden="true" />
                  ))}
                </span>
              )}
              {page.googleReviewCount && <span>{page.googleReviewCount} recensioni</span>}
            </div>
          )}
        </div>

        {googleReviews.length > 0 && (
          <div class="google-review-list">
            {googleReviews.map((review) => {
              const rating = Math.min(5, Math.max(1, review.rating || 5));
              const reviewDate = formatReviewDate(review.reviewDate);
              return (
                <article class="google-review-card">
                  <div class="review-author">
                    <span class="author-initial" aria-hidden="true">{review.author.charAt(0)}</span>
                    <div class="review-author-meta">
                      <strong>{review.author}</strong>
                      <span class="review-stars stars" aria-label={`${rating} stelle su 5`}>
                        {Array.from({ length: 5 }).map((_, index) => (
                          <Star size={15} stroke-width={1.8} class:list={{ filled: index < rating }} aria-hidden="true" />
                        ))}
                      </span>
                    </div>
                  </div>
                  <blockquote>
                    {review.text}
                    {reviewDate && <span class="review-date">{reviewDate}</span>}
                  </blockquote>
                  {review.sourceUrl ? (
                    <a class="google-review-source" href={review.sourceUrl} target="_blank" rel="noopener noreferrer nofollow" aria-label={`Apri la recensione Google di ${review.author}`}>
                      <span aria-hidden="true">G</span>
                    </a>
                  ) : (
                    <span class="google-review-source" aria-hidden="true">G</span>
                  )}
                </article>
              );
            })}
          </div>
        )}

        <a class="button google-link" href={googleReviewsUrl} target="_blank" rel="noopener noreferrer nofollow">
          {page.googleButtonLabel || "Vedi tutte le recensioni su Google"}
          <ExternalLink size={17} stroke-width={1.8} aria-hidden="true" />
        </a>
      </div>
    </section>
  )}

  <CTASection {...page.cta} />
</MainLayout>

<style>
  .testimonials-page-hero { position:relative; overflow:hidden; padding:40px 0 32px; }
  .testimonials-page-hero > .container { position:relative; z-index:1; }
  .testimonials-page-hero h1 { max-width:660px; margin-bottom:14px; font-size:clamp(2.5rem,3.2vw,3.15rem); line-height:1.08; }
  .testimonials-page-hero .lead { max-width:570px; margin-bottom:0; font-size:.95rem; line-height:1.62; }
  .hero-quote { position:absolute; z-index:0; color:rgba(120,151,124,.2); font-family:Georgia,"Times New Roman",serif; line-height:.72; pointer-events:none; user-select:none; }
  .hero-quote-open { top:14%; left:58%; font-size:clamp(18rem,22vw,24rem); }
  .hero-quote-close { top:56%; left:70%; font-size:clamp(5.5rem,7vw,7.5rem); }
  .testimonials-hero { min-height:480px; display:grid; align-items:end; background-image:linear-gradient(90deg,rgba(16,24,20,.68),rgba(16,24,20,.18)),var(--testimonials-hero); background-position:center; background-size:cover; padding-bottom:60px; }
  .testimonials-hero h1, .testimonials-hero .lead { color:white; }
  .google-reviews-section { border-top:1px solid rgba(38,51,44,.08); border-bottom:1px solid rgba(38,51,44,.08); background:linear-gradient(180deg,#fffdf8 0%,#f4f7f2 100%); padding:clamp(52px,6vw,76px) 0; }
  .google-reviews-panel { max-width:980px; border:1px solid rgba(38,51,44,.18); border-radius:10px; background:rgba(255,253,248,.78); box-shadow:0 22px 60px rgba(38,51,44,.08); padding:clamp(28px,5vw,48px); }
  .google-summary { max-width:720px; margin:0 auto 28px; border-top:1px solid rgba(38,51,44,.14); padding-top:28px; text-align:center; }
  .google-summary h2 { margin-bottom:12px; color:var(--color-primary); font-size:clamp(2rem,4vw,2.85rem); }
  .google-subtitle { max-width:620px; margin:0 auto 8px; color:var(--color-primary); font-weight:800; line-height:1.55; }
  .google-intro { max-width:620px; margin:0 auto; color:var(--color-muted); line-height:1.65; }
  .rating-summary { display:flex; flex-wrap:wrap; align-items:center; justify-content:center; gap:10px; margin:22px 0 0; color:var(--color-muted); font-size:1.02rem; }
  .rating-summary > strong { color:var(--color-ink); font-family:Georgia,"Times New Roman",serif; font-size:2.05rem; font-weight:700; line-height:1; }
  .stars { display:inline-flex; gap:3px; color:#c6a056; }
  .stars :global(svg.filled) { fill:currentColor; }
  .google-review-list { display:grid; gap:12px; max-width:840px; margin:0 auto; }
  .google-review-card { display:grid; grid-template-columns:150px minmax(0,1fr) 42px; gap:22px; align-items:center; border:1px solid rgba(38,51,44,.12); border-radius:9px; background:#fffdf8; padding:18px 20px; box-shadow:0 10px 26px rgba(38,51,44,.06); }
  .review-author { display:grid; grid-template-columns:44px minmax(0,1fr); gap:12px; align-items:center; }
  .author-initial { display:grid; width:44px; height:44px; place-items:center; border-radius:50%; background:linear-gradient(135deg,var(--color-primary),var(--color-primary-700)); color:white; font-family:Georgia,"Times New Roman",serif; font-size:1.3rem; line-height:1; box-shadow:inset 0 0 0 1px rgba(255,255,255,.25); }
  .review-author-meta { min-width:0; }
  .review-author strong { display:block; margin-bottom:4px; color:var(--color-primary); font-weight:850; line-height:1.2; }
  .review-stars { display:flex; }
  .google-review-card blockquote { margin:0; color:var(--color-primary); font-size:1rem; font-weight:600; line-height:1.55; }
  .review-date { display:block; margin-top:5px; color:var(--color-muted); font-size:.8rem; font-weight:500; }
  .google-review-source { display:grid; width:34px; height:34px; place-items:center; justify-self:end; border-radius:50%; background:white; color:#4285f4; font-weight:900; box-shadow:0 4px 12px rgba(38,51,44,.08); }
  .google-link { display:flex; width:max-content; margin:28px auto 0; gap:9px; align-items:center; border-color:var(--color-primary); background:var(--color-primary); color:white; box-shadow:0 12px 28px rgba(36,77,61,.18); }
  @media (max-width:900px) { .testimonials-page-hero { padding:40px 0 32px; } .testimonials-page-hero h1 { max-width:600px; font-size:clamp(2.35rem,6vw,3rem); } .hero-quote-open { top:16%; left:58%; font-size:clamp(13rem,26vw,17rem); } .hero-quote-close { top:56%; left:72%; font-size:clamp(4.25rem,8vw,5.75rem); } }
  @media (max-width:640px) { .hero-quote { display:none; } }
  @media (max-width:720px) { .google-review-card { grid-template-columns:1fr 34px; gap:12px; } .review-author { grid-column:1 / -1; } .google-review-card blockquote { grid-column:1; } .google-review-source { grid-column:2; grid-row:2; align-self:start; } }
  @media (max-width:520px) { .google-reviews-section { padding:40px 0; } .google-reviews-panel { width:min(100% - 24px,980px); padding:24px 16px; } .google-review-card { padding:16px; } .google-link { width:100%; } }
</style>
