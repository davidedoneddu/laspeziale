---
import { ArrowRight } from "@lucide/astro";
import MainLayout from "../layouts/MainLayout.astro";
import CTASection from "../components/CTASection.astro";
import { getSiteSettings } from "../lib/sanity";

const settings = await getSiteSettings();
---

<MainLayout
  title="Consulenze autonome | La Speziale Milano"
  description="Consulenze autonome La Speziale: consiglio fitoterapico e percorso con il Tutor del Benessere."
>
  <section class="consulting-hero">
    <div class="container consulting-hero-inner">
      <h1>A volte sai già da dove vuoi partire.</h1>
      <div class="hero-copy">
        <p class="lead">
          Può essere un disturbo da affrontare con la fitoterapia oppure qualcosa che vuoi cambiare nelle tue abitudini e nel tuo stile di vita.
        </p>
        <p class="hero-highlight">In questi casi puoi scegliere direttamente la consulenza più adatta.</p>
        <a class="button button-primary" href="#servizi">Scopri le consulenze</a>
      </div>
    </div>
  </section>

  <section class="section consulting-services" id="servizi">
    <div class="container">
      <header class="services-head">
        <h2>Due modi diversi di partire da ciò che ti serve.</h2>
      </header>

      <div class="services-grid">
        <article class="service-card">
          <img
            class="service-image"
            src="/assets/old-site/fitoterapia-consulenza-2026.jpg"
            alt="Piante officinali e preparazioni per la Consulenza Fitoterapica"
            loading="lazy"
            decoding="async"
          />
          <div class="service-copy">
            <h3>Consulenza Fitoterapica</h3>
            <p class="service-highlight">Quando cerchi una risposta mirata a un disturbo o a una fase particolare.</p>
            <p>
              La consulenza parte dall’ascolto delle tue esigenze, delle abitudini e di ciò che stai già assumendo, per individuare rimedi fitoterapici e nutraceutici adatti alla situazione.
            </p>
            <a class="service-link" href="/fitoterapia">Vai alla Fitoterapia <ArrowRight size={16} aria-hidden="true" /></a>
          </div>
        </article>

        <article class="service-card">
          <img
            class="service-image"
            src="/assets/old-site/consapevolezza-2026.jpg"
            alt="Percorso con il Tutor del Benessere"
            loading="lazy"
            decoding="async"
          />
          <div class="service-copy">
            <h3>Percorso con il Tutor del Benessere</h3>
            <p class="service-highlight">Quando sai cosa vorresti cambiare, ma farlo nella quotidianità è la parte più difficile.</p>
            <p>
              Il percorso aiuta a trasformare obiettivi e intenzioni in abitudini più sostenibili, lavorando su motivazione, organizzazione e continuità.
            </p>
            <a class="service-link" href="/consapevolezza">Scopri il percorso <ArrowRight size={16} aria-hidden="true" /></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <CTASection
    title="Non sai quale scegliere?"
    text="Raccontaci cosa vorresti affrontare: ti aiuteremo a capire da quale consulenza iniziare."
    primaryLabel="Scrivi su WhatsApp"
    primaryLink={settings.whatsapp || "/contatti"}
    secondaryLabel="Vai ai contatti"
    secondaryLink="/contatti"
  />
</MainLayout>

<style>
  .consulting-hero {
    background:
      radial-gradient(circle at 15% 12%, rgba(120, 151, 124, 0.15), transparent 34%),
      linear-gradient(135deg, var(--color-white) 0%, var(--color-ivory) 56%, var(--color-beige) 100%);
    padding: clamp(56px, 7vw, 88px) 0;
  }

  .consulting-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.68fr);
    gap: clamp(28px, 6vw, 76px);
    align-items: end;
  }

  .consulting-hero h1 {
    max-width: 780px;
    color: var(--color-primary);
    font-size: clamp(2.35rem, 4.6vw, 4rem);
    line-height: 1.04;
  }

  .hero-copy {
    max-width: 560px;
  }

  .hero-copy .lead {
    margin-bottom: 18px;
  }

  .hero-highlight {
    margin-bottom: 26px;
    color: var(--color-ink);
    font-size: 1.14rem;
    font-weight: 800;
    line-height: 1.55;
  }

  .consulting-services {
    background: var(--color-ivory);
  }

  .services-head {
    max-width: 860px;
    margin-bottom: clamp(28px, 4vw, 42px);
  }

  .services-head h2 {
    margin-bottom: 0;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 30px);
  }

  .service-card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow-soft);
  }

  .service-image {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #eef2ec;
    object-fit: contain;
  }

  .service-copy {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 4vw, 38px);
  }

  .service-card h3 {
    margin-bottom: 14px;
    color: var(--color-primary);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.75rem, 2.8vw, 2.35rem);
    font-weight: 500;
    line-height: 1.12;
  }

  .service-highlight {
    margin-bottom: 16px;
    color: var(--color-ink);
    font-size: 1.02rem;
    font-weight: 800;
    line-height: 1.55;
  }

  .service-copy p:not(.service-highlight) {
    flex: 1;
    font-size: 1rem;
    line-height: 1.76;
  }

  .service-link {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    align-self: flex-start;
    margin-top: 22px;
    color: var(--color-primary);
    font-weight: 900;
  }

  @media (max-width: 900px) {
    .consulting-hero-inner,
    .services-grid {
      grid-template-columns: 1fr;
    }

    .consulting-hero-inner {
      align-items: start;
    }

    .hero-copy {
      max-width: 680px;
    }
  }

  @media (max-width: 560px) {
    .consulting-hero {
      padding: 48px 0;
    }

    .hero-copy .button {
      width: 100%;
    }

    .service-image {
      aspect-ratio: 4 / 3;
    }

    .service-copy {
      padding: 24px 20px;
    }
  }
</style>
