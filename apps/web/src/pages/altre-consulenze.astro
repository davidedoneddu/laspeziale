---
import { ArrowRight, Leaf, MessageCircle, Sparkles } from "@lucide/astro";
import MainLayout from "../layouts/MainLayout.astro";
import CTASection from "../components/CTASection.astro";
import { getSiteSettings } from "../lib/sanity";

const settings = await getSiteSettings();
---

<MainLayout
  title="Altre consulenze | La Speziale Milano"
  description="Consulenze stand-alone La Speziale: fitoterapia, rimedi naturali, consapevolezza alimentare e coaching senza percorso dieta."
>
  <section class="consulting-hero">
    <div class="container consulting-hero-inner">
      <div>
        <p class="eyebrow">Altre consulenze</p>
        <h1>Supporti mirati, anche senza iniziare una dieta.</h1>
        <p class="lead">
          Non ogni bisogno richiede un piano alimentare completo. Alcune esigenze possono essere affrontate con una consulenza specifica, chiara e circoscritta.
        </p>
        <div class="button-row">
          <a class="button button-primary" href="/contatti">Prenota una consulenza</a>
          <a class="button button-secondary" href="#servizi">Scopri i servizi</a>
        </div>
      </div>
      <aside class="consulting-note">
        <span>Senza dieta</span>
        <strong>Fitoterapia, prodotti consigliati e coaching sulle abitudini.</strong>
        <p>Una porta d'ingresso piu leggera per lavorare su fastidi specifici, continuita e consapevolezza quotidiana.</p>
      </aside>
    </div>
  </section>

  <section class="section consulting-services" id="servizi">
    <div class="container">
      <header class="services-head">
        <p class="eyebrow">Servizi stand-alone</p>
        <h2>Due consulenze indipendenti, costruite con lo stesso metodo La Speziale.</h2>
      </header>

      <div class="services-grid">
        <article class="service-card service-card-featured">
          <div class="service-icon"><Leaf size={28} stroke-width={1.7} aria-hidden="true" /></div>
          <p class="eyebrow">Rimedi naturali</p>
          <h3>Consulenza Fitoterapica</h3>
          <p>
            Un aiuto naturale e mirato per fastidi specifici, disturbi stagionali, drenaggio, sonno, digestione, energia e benessere ormonale.
          </p>
          <a class="service-link" href="/fitoterapia">Vai alla fitoterapia <ArrowRight size={16} aria-hidden="true" /></a>
        </article>

        <article class="service-card">
          <div class="service-icon"><Sparkles size={28} stroke-width={1.7} aria-hidden="true" /></div>
          <p class="eyebrow">Abitudini e continuita</p>
          <h3>Percorso di Consapevolezza e Coaching</h3>
          <p>
            Un percorso per osservare abitudini, fame, motivazione e rapporto con il corpo, senza rigidita e senza schemi alimentari complessi.
          </p>
          <a class="service-link" href="/consapevolezza">Scopri il coaching <ArrowRight size={16} aria-hidden="true" /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section consulting-choice">
    <div class="container choice-panel">
      <div>
        <p class="eyebrow">Come scegliere</p>
        <h2>Se serve un piano completo, parti dal Metodo. Se serve un supporto mirato, parti da qui.</h2>
      </div>
      <div class="choice-list">
        <article>
          <span>01</span>
          <h3>Percorso completo</h3>
          <p>Dieta personalizzata, consulenza, follow-up, fitoterapia e prodotti consigliati quando utili.</p>
          <a href="/il-metodo">Approfondisci il Metodo</a>
        </article>
        <article>
          <span>02</span>
          <h3>Consulenza mirata</h3>
          <p>Un intervento specifico per fastidi o abitudini, senza avviare un piano alimentare completo.</p>
          <a href="/contatti">Chiedi orientamento</a>
        </article>
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Orientamento"
    title="Vuoi capire quale consulenza fa per te?"
    text="Scrivici: ti aiutiamo a scegliere tra percorso completo, fitoterapia e coaching."
    primaryLabel="Scrivi su WhatsApp"
    primaryLink={settings.whatsapp || "/contatti"}
    secondaryLabel="Vai ai contatti"
    secondaryLink="/contatti"
  />
</MainLayout>

<style>
  .consulting-hero {
    background:
      radial-gradient(circle at 15% 12%, rgba(197, 155, 39, 0.16), transparent 32%),
      linear-gradient(135deg, var(--color-white) 0%, var(--color-ivory) 52%, var(--color-beige) 100%);
    padding: clamp(72px, 10vw, 132px) 0 clamp(58px, 8vw, 96px);
  }

  .consulting-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 0.42fr);
    gap: clamp(30px, 6vw, 74px);
    align-items: end;
  }

  .consulting-hero h1 {
    max-width: 900px;
    color: var(--color-primary);
    font-size: clamp(2.15rem, 4.6vw, 3.75rem);
  }

  .consulting-note {
    border: 1px solid rgba(197, 155, 39, 0.22);
    border-radius: var(--radius);
    background: rgba(255, 253, 248, 0.78);
    box-shadow: var(--shadow-soft);
    padding: clamp(24px, 4vw, 32px);
  }

  .consulting-note span {
    display: inline-flex;
    margin-bottom: 18px;
    border-radius: 999px;
    background: rgba(197, 155, 39, 0.12);
    color: var(--color-gold-dark);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.09em;
    padding: 8px 12px;
    text-transform: uppercase;
  }

  .consulting-note strong {
    display: block;
    color: var(--color-primary);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.65rem;
    font-weight: 500;
    line-height: 1.12;
  }

  .consulting-note p {
    margin: 16px 0 0;
  }

  .consulting-services {
    background: var(--color-ivory);
  }

  .services-head {
    max-width: 780px;
    margin-bottom: 34px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .service-card {
    display: flex;
    min-height: 380px;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow-soft);
    padding: clamp(26px, 4vw, 42px);
  }

  .service-card-featured {
    background:
      radial-gradient(circle at 85% 15%, rgba(197, 155, 39, 0.16), transparent 30%),
      var(--color-white);
  }

  .service-icon {
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    border-radius: 50%;
    background: rgba(197, 155, 39, 0.12);
    color: var(--color-gold-dark);
    margin-bottom: 24px;
  }

  .service-card h3 {
    max-width: 520px;
    margin-bottom: 16px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 500;
  }

  .service-card p:not(.eyebrow) {
    flex: 1;
    font-size: 1rem;
    line-height: 1.76;
  }

  .service-link,
  .choice-list a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--color-gold-dark);
    font-weight: 900;
  }

  .consulting-choice {
    background: var(--color-white);
  }

  .choice-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(28px, 6vw, 70px);
    align-items: start;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-top: clamp(36px, 6vw, 64px);
    padding-bottom: clamp(36px, 6vw, 64px);
  }

  .choice-list {
    display: grid;
    gap: 18px;
  }

  .choice-list article {
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: var(--color-ivory);
    padding: 24px;
  }

  .choice-list span {
    display: block;
    margin-bottom: 18px;
    color: var(--color-gold-dark);
    font-weight: 900;
  }

  .choice-list h3 {
    color: var(--color-primary);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.7rem;
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .consulting-hero-inner,
    .services-grid,
    .choice-panel {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 0;
    }
  }
</style>
