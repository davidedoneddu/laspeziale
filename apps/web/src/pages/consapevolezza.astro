---
import MainLayout from "../layouts/MainLayout.astro";
import CTASection from "../components/CTASection.astro";
import { getCoachingPage } from "../lib/sanity";

const page = await getCoachingPage();
const audience = page.audienceItems || [];
const methodSteps = page.methodSteps || [];
const focusCards = [
  {
    title: methodSteps[0]?.title || "Perché nasce",
    subtitle: page.introTitle,
    text: page.introText,
  },
  {
    title: methodSteps[1]?.title || "Il Tutor del Benessere",
    text:
      methodSteps[1]?.text ||
      "Attraverso il linguaggio del corpo aiuta a riconoscere il modo in cui ci si esprime, ci si percepisce e ci si relaziona con gli altri, favorendo una maggiore armonia tra ciò che si vive interiormente e ciò che si comunica. L'obiettivo non è cambiare la persona, ma aiutarla a valorizzare le proprie risorse, affrontare con maggiore serenità i cambiamenti e consolidare nel tempo un nuovo equilibrio.",
  },
  {
    title: methodSteps[2]?.title || "Come si svolge",
    text:
      methodSteps[2]?.text ||
      "Ogni incontro parte dalla persona e dalla fase della vita che sta vivendo. Il linguaggio del corpo diventa uno strumento per osservare il modo in cui affrontiamo i cambiamenti, riconoscere ciò che ci limita e sviluppare nuove modalità di vivere noi stessi. Il percorso offre spunti pratici da applicare nella quotidianità, affinché la consapevolezza possa trasformarsi in un cambiamento concreto e duraturo.",
  },
];
---

<MainLayout title={page.seo?.title} description={page.seo?.description || page.heroText} image={page.seo?.imageUrl || page.heroImageUrl}>
  <section class="awareness-hero" style={`--awareness-image: url('${page.heroImageUrl || "/assets/old-site/consapevolezza-2026.jpg"}')`}>
    <div class="container awareness-hero-inner">
      <div class="awareness-copy">
        <h1>{page.heroTitle}</h1>
        {page.heroSubtitle && <p class="hero-subtitle">{page.heroSubtitle}</p>}
        {page.heroText && <p class="lead">{page.heroText}</p>}
        <div class="button-row">
          <a class="button button-primary" href="/contatti">Prenota una consulenza</a>
        </div>
      </div>
      <div class="awareness-visual" aria-hidden="true">
        <div class="awareness-photo"></div>
      </div>
    </div>
  </section>

  <section class="section awareness-focus">
    <div class="container">
      <header class="focus-head">
        <p>{page.methodTitle || "Il linguaggio del corpo come strumento di osservazione e crescita."}</p>
      </header>
      <div class="focus-grid">
        {focusCards.map((card) => (
            <article>
              <h2>{card.title}</h2>
              {card.subtitle && <p class="section-subtitle">{card.subtitle}</p>}
              {card.text && <p>{card.text}</p>}
            </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section awareness-audience">
    <div class="container audience-panel">
      <div>
        <h2>{page.audienceTitle || "A chi è rivolta"}</h2>
      </div>
      <ul>
        {audience.map((item) => (
          <li>
            <span class="list-marker" aria-hidden="true">—</span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTASection {...page.cta} />
</MainLayout>

<style>
  .awareness-hero {
    background:
      radial-gradient(circle at 12% 12%, rgba(197, 155, 39, 0.13), transparent 28%),
      linear-gradient(135deg, var(--color-white) 0%, var(--color-ivory) 54%, var(--color-beige) 100%);
    padding: clamp(56px, 6vw, 80px) 0;
  }

  .awareness-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.72fr);
    gap: clamp(34px, 7vw, 86px);
    align-items: center;
  }

  .awareness-copy h1 {
    max-width: 820px;
    font-size: clamp(2.1rem, 4.4vw, 3.65rem);
  }

  .hero-subtitle {
    color: var(--color-primary);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.15rem, 2.3vw, 1.65rem);
    font-weight: 700;
    margin: 0 0 18px;
  }

  .awareness-visual {
    position: relative;
    aspect-ratio: 3 / 2;
    min-height: 0;
  }

  .awareness-photo {
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    background-image:
      linear-gradient(180deg, rgba(19, 56, 43, 0.05), rgba(19, 56, 43, 0.14)),
      var(--awareness-image);
    background-position: center;
    background-repeat: no-repeat;
    background-size: 100% 100%, contain;
    background-color: #eef2ec;
    box-shadow: var(--shadow-soft);
  }

  .awareness-focus {
    background: var(--color-white);
  }

  .audience-panel h2,
  .focus-grid h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .section-subtitle {
    margin: 14px 0 0;
    color: #244D3D;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.18rem, 2.2vw, 1.55rem);
    font-weight: 700;
    line-height: 1.35;
  }

  .focus-head {
    max-width: 780px;
    margin-bottom: 24px;
  }

  .focus-head p {
    margin: 0;
    color: var(--color-muted);
    font-size: clamp(1.05rem, 1.7vw, 1.28rem);
    font-weight: 500;
    line-height: 1.55;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .focus-grid article {
    display: grid;
    min-height: 300px;
    align-content: start;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-ivory);
    padding: 26px;
  }

  .focus-grid h2 {
    margin-bottom: 14px;
    color: var(--color-primary);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.55rem, 2.5vw, 2rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .focus-grid .section-subtitle {
    margin: 0 0 14px;
    font-size: 1.08rem;
  }

  .focus-grid p {
    line-height: 1.7;
  }

  .awareness-audience {
    background: var(--color-ivory);
  }

  .audience-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(28px, 6vw, 72px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow-soft);
    padding: clamp(28px, 5vw, 48px);
  }

  .audience-panel ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .audience-panel li {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 10px;
    align-items: start;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-primary);
    font-weight: 760;
    padding: 0 0 14px;
  }

  .audience-panel li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .list-marker {
    color: var(--color-primary);
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .awareness-hero-inner,
    .audience-panel {
      grid-template-columns: 1fr;
    }

    .awareness-visual {
      min-height: 0;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
