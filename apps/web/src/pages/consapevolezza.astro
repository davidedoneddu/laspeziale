---
import { ArrowRight, Eye, HeartHandshake, Sparkles, UserRoundCheck } from "@lucide/astro";
import MainLayout from "../layouts/MainLayout.astro";
import CTASection from "../components/CTASection.astro";
import { getCoachingPage } from "../lib/sanity";

const page = await getCoachingPage();
const audience = page.audienceItems || [];
const focusCards = [
  {
    icon: UserRoundCheck,
    title: "Perche nasce",
    text: page.introText,
  },
  {
    icon: Eye,
    title: "Il Tutor del Benessere",
    text: "Attraverso il linguaggio del corpo aiuta a riconoscere il modo in cui ci si esprime, ci si percepisce e ci si relaziona con gli altri, favorendo una maggiore armonia tra cio che si vive interiormente e cio che si comunica. L'obiettivo non e cambiare la persona, ma aiutarla a valorizzare le proprie risorse, affrontare con maggiore serenita i cambiamenti e consolidare nel tempo un nuovo equilibrio.",
  },
  {
    icon: Sparkles,
    title: "Come si svolge",
    text: "Ogni incontro parte dalla persona e dalla fase della vita che sta vivendo. Il linguaggio del corpo diventa uno strumento per osservare il modo in cui affrontiamo i cambiamenti, riconoscere cio che ci limita e sviluppare nuove modalita di vivere noi stessi. Il percorso offre spunti pratici da applicare nella quotidianita, affinche la consapevolezza possa trasformarsi in un cambiamento concreto e duraturo.",
  },
];
---

<MainLayout title={page.seo?.title} description={page.seo?.description || page.heroText} image={page.seo?.imageUrl || page.heroImageUrl}>
  <section class="awareness-hero" style={`--awareness-image: url('${page.heroImageUrl || "/assets/old-site/consapevolezza.png"}')`}>
    <div class="container awareness-hero-inner">
      <div class="awareness-copy">
        <p class="eyebrow">{page.heroEyebrow || "Consulenza di Consapevolezza"}</p>
        <h1>{page.heroTitle}</h1>
        {page.heroText && <p class="lead">{page.heroText}</p>}
        <div class="button-row">
          <a class="button button-primary" href="/contatti">Prenota una consulenza</a>
        </div>
      </div>
      <div class="awareness-visual" aria-hidden="true">
        <div class="awareness-photo"></div>
        <div class="awareness-card">
          <span>Persona al centro</span>
          <strong>Riconoscersi e il primo passo per stare bene con se stessi.</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section awareness-intro">
    <div class="container intro-grid">
      <div>
        <p class="eyebrow">Perche nasce</p>
        <h2>{page.introTitle}</h2>
      </div>
      {page.introText && <p>{page.introText}</p>}
    </div>
  </section>

  <section class="section awareness-focus">
    <div class="container">
      <header class="focus-head">
        <p class="eyebrow">Il percorso</p>
        <h2>{page.methodTitle || "Il linguaggio del corpo come strumento di osservazione e crescita."}</h2>
      </header>
      <div class="focus-grid">
        {focusCards.map((card) => {
          const CardIcon = card.icon;
          return (
            <article>
              <CardIcon size={30} stroke-width={1.7} aria-hidden="true" />
              <h3>{card.title}</h3>
              {card.text && <p>{card.text}</p>}
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section awareness-audience">
    <div class="container audience-panel">
      <div>
        <p class="eyebrow">A chi e rivolta</p>
        <h2>{page.audienceTitle || "A chi desidera dedicare tempo alla propria persona."}</h2>
      </div>
      <ul>
        {audience.map((item) => (
          <li>
            <HeartHandshake size={18} stroke-width={2.2} aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section awareness-close">
    <div class="container close-panel">
      <div>
        <p class="eyebrow">Consapevolezza</p>
        <h2>Ogni percorso inizia da una maggiore conoscenza di se.</h2>
      </div>
      <a class="text-link" href="/il-metodo">
        Scopri il Metodo La Speziale <ArrowRight size={16} aria-hidden="true" />
      </a>
    </div>
  </section>

  <CTASection {...page.cta} />
</MainLayout>

<style>
  .awareness-hero {
    background:
      radial-gradient(circle at 12% 12%, rgba(197, 155, 39, 0.13), transparent 28%),
      linear-gradient(135deg, var(--color-white) 0%, var(--color-ivory) 54%, var(--color-beige) 100%);
    padding: clamp(66px, 9vw, 118px) 0 clamp(54px, 7vw, 92px);
  }

  .awareness-hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.72fr);
    gap: clamp(34px, 7vw, 86px);
    align-items: center;
  }

  .awareness-copy h1 {
    max-width: 820px;
    font-size: clamp(2.1rem, 4.4vw, 3.65rem);
  }

  .awareness-visual {
    position: relative;
    min-height: 520px;
  }

  .awareness-photo {
    position: absolute;
    inset: 0 0 54px 42px;
    border-radius: var(--radius);
    background-image:
      linear-gradient(180deg, rgba(19, 56, 43, 0.05), rgba(19, 56, 43, 0.14)),
      var(--awareness-image);
    background-position: center;
    background-size: cover;
    box-shadow: var(--shadow-soft);
  }

  .awareness-card {
    position: absolute;
    right: 26px;
    bottom: 0;
    max-width: 300px;
    border: 1px solid rgba(197, 155, 39, 0.24);
    border-radius: 22px;
    background: rgba(255, 253, 248, 0.92);
    box-shadow: 0 20px 54px rgba(19, 56, 43, 0.13);
    padding: 24px;
  }

  .awareness-card span {
    display: inline-flex;
    margin-bottom: 14px;
    border-radius: 999px;
    background: rgba(197, 155, 39, 0.12);
    color: var(--color-gold-dark);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 7px 10px;
    text-transform: uppercase;
  }

  .awareness-card strong {
    color: var(--color-primary);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.42rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .awareness-intro,
  .awareness-focus {
    background: var(--color-white);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(26px, 6vw, 72px);
    align-items: start;
  }

  .intro-grid h2,
  .audience-panel h2,
  .focus-head h2,
  .close-panel h2 {
    font-size: clamp(2rem, 4vw, 3.25rem);
  }

  .intro-grid > p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.82;
  }

  .focus-head {
    max-width: 780px;
    margin-bottom: 30px;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .focus-grid article {
    display: grid;
    min-height: 300px;
    align-content: start;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-ivory);
    padding: 26px;
  }

  .focus-grid :global(svg) {
    color: var(--color-tertiary);
    margin-bottom: 20px;
  }

  .focus-grid h3 {
    color: var(--color-primary);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.45rem;
    font-weight: 500;
  }

  .focus-grid p {
    line-height: 1.7;
  }

  .awareness-audience,
  .awareness-close {
    background: var(--color-ivory);
  }

  .audience-panel {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(28px, 6vw, 72px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-white);
    box-shadow: var(--shadow-soft);
    padding: clamp(28px, 5vw, 48px);
  }

  .audience-panel ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .audience-panel li {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 12px;
    align-items: start;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-primary);
    font-weight: 760;
    padding: 0 0 14px;
  }

  .audience-panel li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .audience-panel :global(svg) {
    color: var(--color-tertiary);
    margin-top: 0.2em;
  }

  .close-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px;
    align-items: end;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-top: 44px;
    padding-bottom: 44px;
  }

  .text-link {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    color: var(--color-gold-dark);
    font-weight: 900;
    white-space: nowrap;
  }

  @media (max-width: 860px) {
    .awareness-hero-inner,
    .intro-grid,
    .audience-panel,
    .close-panel {
      grid-template-columns: 1fr;
    }

    .awareness-visual {
      min-height: 420px;
    }

    .awareness-photo {
      inset: 0 0 46px 0;
    }

    .focus-grid {
      grid-template-columns: 1fr;
    }

    .text-link {
      white-space: normal;
    }
  }
</style>
