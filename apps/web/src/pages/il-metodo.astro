---
import CTASection from "../components/CTASection.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { getMethodPage } from "../lib/sanity";

const page = await getMethodPage();
const introParagraphs = (page.introText || "").split("\n").filter(Boolean);
const resultParagraphs = (page.phytoText || "").split("\n").filter(Boolean);
const workSteps = page.workSteps || [];
const pillars = page.pillars || [];
const visitBoxes = page.visitBoxes || [];
---

<MainLayout title={page.seo?.title} description={page.seo?.description} image={page.seo?.imageUrl || page.introImageUrl}>
  <section class="method-hero">
    <div class="container method-hero-grid">
      <div class="method-hero-copy">
        <h1>{page.introHeading}</h1>
        {page.introTitle && <p class="hero-subtitle">{page.introTitle}</p>}
        <div class="hero-text">
          {introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
      {page.introImageUrl && (
        <figure class="method-hero-figure">
          <img src={page.introImageUrl} alt="Il Metodo La Speziale" />
        </figure>
      )}
    </div>
  </section>

  {(page.dietTitle || page.dietText || pillars.length > 0) && (
    <section class="section method-competences">
      <div class="container">
        <div class="section-heading centered">
          {page.dietTitle && <h2>{page.dietTitle}</h2>}
          {page.dietText && <p>{page.dietText}</p>}
        </div>
        {pillars.length > 0 && (
          <div class="competence-grid">
            {pillars.map((pillar) => (
              <article class="competence-card">
                <h3>{pillar.title}</h3>
                {pillar.role && <p class="role">{pillar.role}</p>}
                {pillar.text && <p>{pillar.text}</p>}
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {(page.coreTitle || workSteps.length > 0) && (
    <section class="section method-path">
      <div class="container">
        <div class="section-heading centered compact">
          {page.coreTitle && <h2>{page.journeyTitle || "Il percorso"}</h2>}
          {page.coreTitle && <p class="section-subtitle">{page.coreTitle}</p>}
          {page.journeyHighlight && <p>{page.journeyHighlight}</p>}
        </div>
        {workSteps.length > 0 && (
          <div class="steps-grid">
            {workSteps.map((step, index) => (
              <article class="step-card">
                <span class="item-number">{step.number || String(index + 1).padStart(2, "0")}.</span>
                <h3>{step.title}</h3>
                {step.text && <p>{step.text}</p>}
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  )}

  {visitBoxes.length > 0 && (
    <section class="section method-visits">
      <div class="container visit-grid">
        {visitBoxes.map((box) => (
          <article class="surface visit-card">
            <h2>{box.title}</h2>
            <ul>
              {(box.items || []).map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>
  )}

  {(page.phytoTitle || page.resultHighlight || resultParagraphs.length > 0) && (
    <section class="section method-result">
      <div class="container result-copy">
        {page.phytoTitle && <h2>{page.phytoTitle}</h2>}
        {page.resultHighlight && <p class="result-highlight">{page.resultHighlight}</p>}
        {resultParagraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </section>
  )}

  {page.cta && <CTASection {...page.cta} immersive titleAsHeading={false} />}
</MainLayout>

<style>
  .method-hero {
    background:
      radial-gradient(circle at 16% 12%, rgba(120, 151, 124, 0.13), transparent 32%),
      linear-gradient(135deg, var(--color-white) 0%, var(--color-ivory) 62%, var(--color-beige) 100%);
    padding: clamp(56px, 7vw, 92px) 0;
  }

  .method-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(320px, 1.08fr);
    gap: clamp(34px, 5vw, 72px);
    align-items: center;
  }

  .method-hero-copy {
    max-width: 620px;
  }

  .method-hero h1 {
    margin-bottom: 18px;
    color: var(--color-primary);
    font-size: clamp(2.75rem, 5vw, 5rem);
    line-height: 0.98;
  }

  .hero-subtitle {
    margin: 0 0 26px;
    color: var(--color-primary);
    font-size: clamp(1.1rem, 1.8vw, 1.42rem);
    font-weight: 800;
    line-height: 1.35;
  }

  .hero-text p {
    margin-bottom: 16px;
    line-height: 1.72;
  }

  .method-hero-figure {
    display: block;
    margin: 0;
    overflow: hidden;
    border-radius: 24px;
    box-shadow: var(--shadow-soft);
  }

  .method-hero-figure img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: initial;
  }

  .section-heading {
    max-width: 760px;
    margin: 0 0 clamp(28px, 4vw, 44px);
  }

  .section-heading.centered {
    margin-right: auto;
    margin-left: auto;
    text-align: center;
  }

  .section-heading.compact {
    max-width: 700px;
  }

  .section-heading h2,
  .method-result h2 {
    color: var(--color-primary);
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.05;
  }

  .section-heading p {
    margin: 14px auto 0;
    line-height: 1.65;
  }

  .section-subtitle,
  .result-highlight {
    color: var(--color-primary);
    font-weight: 800;
  }

  .competence-grid,
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid rgba(36, 77, 61, 0.14);
    background: rgba(255, 253, 248, 0.76);
  }

  .steps-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .competence-card,
  .step-card {
    padding: clamp(22px, 3vw, 34px);
  }

  .competence-card + .competence-card,
  .step-card + .step-card {
    border-left: 1px solid rgba(36, 77, 61, 0.14);
  }

  .item-number {
    display: block;
    margin-bottom: 14px;
    color: var(--color-primary);
    font-weight: 800;
    letter-spacing: 0.03em;
  }

  .competence-card h3,
  .step-card h3,
  .visit-card h2 {
    margin-bottom: 12px;
    color: var(--color-primary);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.28rem, 2vw, 1.75rem);
    font-weight: 500;
    line-height: 1.12;
  }

  .role {
    margin-bottom: 12px;
    color: var(--color-primary);
    font-size: 0.98rem;
    font-weight: 800;
  }

  .competence-card p,
  .step-card p,
  .visit-card li {
    line-height: 1.65;
  }

  .visit-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .visit-card {
    padding: clamp(24px, 3vw, 34px);
  }

  .visit-card ul {
    display: grid;
    gap: 10px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .visit-card li::before {
    margin-right: 10px;
    color: var(--color-primary);
    content: "—";
  }

  .method-result {
    background: var(--color-white);
  }

  .result-copy {
    max-width: 980px;
    text-align: center;
  }

  .result-highlight {
    max-width: 780px;
    margin: 22px auto 22px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.45rem, 2.5vw, 2.15rem);
    line-height: 1.22;
  }

  .result-copy p:not(.result-highlight) {
    max-width: 800px;
    margin-right: auto;
    margin-left: auto;
    line-height: 1.72;
  }

  @media (max-width: 960px) {
    .method-hero-grid,
    .competence-grid,
    .steps-grid,
    .visit-grid {
      grid-template-columns: 1fr;
    }

    .method-hero-copy {
      max-width: none;
    }

    .competence-card + .competence-card,
    .step-card + .step-card {
      border-top: 1px solid rgba(36, 77, 61, 0.14);
      border-left: 0;
    }

    .method-hero-figure {
      min-height: 0;
    }
  }

  @media (max-width: 560px) {
    .method-hero {
      padding: 44px 0;
    }

    .method-hero h1 {
      font-size: clamp(2.45rem, 14vw, 3.5rem);
    }

    .section-heading.centered,
    .result-copy {
      text-align: left;
    }

    .result-highlight {
      margin-left: 0;
    }
  }
</style>
