---
const pageTitle = "Sito in manutenzione | La Speziale";
const description =
  "Il sito La Speziale è temporaneamente in manutenzione. Stiamo preparando la nuova versione e torneremo presto online.";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="maintenance-page" aria-labelledby="maintenance-title">
      <section class="maintenance-card">
        <img
          class="maintenance-logo"
          src="/assets/old-site/logo.png"
          alt="La Speziale"
          width="180"
          height="64"
        />

        <p class="maintenance-kicker">Sito in manutenzione</p>
        <h1 id="maintenance-title">Stiamo preparando il nuovo sito.</h1>
        <p class="maintenance-copy">
          La Speziale tornerà online a breve con pagine aggiornate, contenuti più chiari e una navigazione più curata.
        </p>
        <p class="maintenance-note">
          Nel frattempo puoi contattarci direttamente per informazioni o appuntamenti.
        </p>

        <div class="maintenance-actions" aria-label="Contatti">
          <a class="maintenance-button maintenance-button-primary" href="mailto:laspeziale@laspeziale.it">
            Scrivi una email
          </a>
          <a class="maintenance-button maintenance-button-secondary" href="tel:+393334063401">
            Chiama lo studio
          </a>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    --background: #f7f8f4;
    --surface: #ffffff;
    --ink: #20312b;
    --muted: #5f7169;
    --line: #dfe6dd;
    --accent: #2f6b4f;
    --accent-dark: #214d39;
    --accent-soft: #e4eee7;
    --shadow: 0 24px 80px rgb(33 77 57 / 0.14);
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-height: 100%;
    background: var(--background);
  }

  body {
    min-height: 100%;
    margin: 0;
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    color: var(--ink);
    background:
      radial-gradient(circle at 12% 18%, rgb(47 107 79 / 0.12), transparent 32rem),
      radial-gradient(circle at 88% 84%, rgb(47 107 79 / 0.1), transparent 28rem),
      linear-gradient(135deg, #fbfcf8 0%, var(--background) 100%);
  }

  a {
    color: inherit;
  }

  .maintenance-page {
    display: grid;
    min-height: 100dvh;
    padding: 32px;
    place-items: center;
  }

  .maintenance-card {
    position: relative;
    width: min(100%, 720px);
    overflow: hidden;
    border: 1px solid rgb(223 230 221 / 0.9);
    border-radius: 28px;
    padding: clamp(32px, 7vw, 72px);
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.94), rgb(255 255 255 / 0.82)),
      var(--surface);
    box-shadow: var(--shadow);
  }

  .maintenance-card::before {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background:
      linear-gradient(90deg, transparent, rgb(47 107 79 / 0.08), transparent),
      radial-gradient(circle at top right, rgb(228 238 231 / 0.9), transparent 24rem);
    content: "";
    pointer-events: none;
  }

  .maintenance-logo,
  .maintenance-kicker,
  .maintenance-card h1,
  .maintenance-copy,
  .maintenance-note,
  .maintenance-actions {
    position: relative;
  }

  .maintenance-logo {
    display: block;
    width: min(180px, 55vw);
    height: auto;
    margin-bottom: 48px;
  }

  .maintenance-kicker {
    width: fit-content;
    margin: 0 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 14px;
    color: var(--accent-dark);
    background: var(--accent-soft);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(2.7rem, 9vw, 5.8rem);
    line-height: 0.95;
    letter-spacing: -0.07em;
  }

  .maintenance-copy {
    max-width: 58ch;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: clamp(1.08rem, 2vw, 1.26rem);
    line-height: 1.65;
  }

  .maintenance-note {
    max-width: 52ch;
    margin: 14px 0 0;
    color: #40564d;
    font-size: 1rem;
    line-height: 1.6;
  }

  .maintenance-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .maintenance-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0 22px;
    font-weight: 800;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      background 160ms ease;
  }

  .maintenance-button:hover {
    transform: translateY(-1px);
  }

  .maintenance-button:active {
    transform: translateY(1px);
  }

  .maintenance-button:focus-visible {
    outline: 3px solid rgb(47 107 79 / 0.35);
    outline-offset: 3px;
  }

  .maintenance-button-primary {
    color: #ffffff;
    background: var(--accent);
    box-shadow: 0 14px 30px rgb(47 107 79 / 0.24);
  }

  .maintenance-button-primary:hover {
    background: var(--accent-dark);
  }

  .maintenance-button-secondary {
    border: 1px solid var(--line);
    color: var(--accent-dark);
    background: rgb(255 255 255 / 0.72);
  }

  .maintenance-button-secondary:hover {
    background: #ffffff;
  }

  @media (max-width: 560px) {
    .maintenance-page {
      padding: 16px;
    }

    .maintenance-card {
      border-radius: 22px;
      padding: 28px;
    }

    .maintenance-logo {
      margin-bottom: 36px;
    }

    h1 {
      max-width: 12ch;
    }

    .maintenance-actions {
      display: grid;
    }

    .maintenance-button {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>
