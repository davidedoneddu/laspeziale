---
import "../styles/global.css";

const pageTitle = "Sito in manutenzione | La Speziale";
const description =
  "Il sito La Speziale è temporaneamente in manutenzione. Stiamo preparando la nuova versione e torneremo presto online.";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="maintenance-page" aria-labelledby="maintenance-title">
      <div class="maintenance-image" aria-hidden="true"></div>
      <section class="container maintenance-shell">
        <a class="maintenance-brand" href="/manutenzione" aria-label="La Speziale">
          <img
            src="/assets/old-site/logo.png"
            alt="Studio nutrizionista La Speziale Milano"
            width="180"
            height="64"
          />
        </a>

        <div class="maintenance-content">
          <p class="eyebrow">Sito in manutenzione</p>
          <h1 id="maintenance-title">Stiamo preparando il nuovo sito.</h1>
          <p class="lead">
            La Speziale tornerà online a breve con contenuti aggiornati e una navigazione più chiara.
          </p>
          <p class="maintenance-note">
            Per informazioni o appuntamenti puoi contattarci direttamente.
          </p>

          <div class="button-row" aria-label="Contatti">
            <a class="button button-primary" href="mailto:laspeziale@laspeziale.it">
              Scrivi una email
            </a>
            <a class="button button-secondary" href="tel:+393334063401">
              Chiama lo studio
            </a>
          </div>
        </div>

        <aside class="maintenance-aside" aria-label="Aggiornamento sito">
          <p>Nuova esperienza digitale in preparazione</p>
          <span>Online a breve</span>
        </aside>
      </section>
    </main>
  </body>
</html>

<style>
  html {
    height: 100%;
    overflow: hidden;
  }

  body {
    height: 100%;
    overflow: hidden;
  }

  .maintenance-page {
    position: relative;
    display: grid;
    height: 100dvh;
    min-height: 100dvh;
    overflow: hidden;
    align-items: center;
    background:
      radial-gradient(circle at 22% 4%, rgba(197, 155, 39, 0.12), transparent 26rem),
      linear-gradient(115deg, #fffdf8 0%, #fcfbf7 48%, #edf3ee 100%);
  }

  .maintenance-image {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 48%;
    opacity: 0.94;
    background-image:
      linear-gradient(90deg, rgba(252, 251, 247, 0.96), rgba(252, 251, 247, 0.44) 34%, rgba(252, 251, 247, 0.05)),
      url("/assets/old-site/hero-header.jpg");
    background-position: 62% center;
    background-size: cover;
    pointer-events: none;
  }

  .maintenance-image::after {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 76% 58%, rgba(120, 151, 124, 0.18), transparent 34%),
      linear-gradient(180deg, rgba(255, 253, 248, 0), rgba(252, 251, 247, 0.34));
    content: "";
  }

  .maintenance-shell {
    position: relative;
    z-index: 1;
    display: grid;
    height: 100dvh;
    max-height: 100dvh;
    grid-template-columns: minmax(0, 0.92fr) minmax(280px, 0.62fr);
    grid-template-rows: auto minmax(0, 1fr);
    column-gap: clamp(52px, 9vw, 132px);
    align-items: center;
    padding-top: clamp(28px, 6vh, 64px);
    padding-bottom: clamp(28px, 6vh, 64px);
  }

  .maintenance-brand {
    display: inline-flex;
    width: fit-content;
    grid-column: 1 / -1;
    align-self: start;
  }

  .maintenance-brand img {
    width: clamp(150px, 13vw, 190px);
    height: auto;
  }

  .maintenance-content {
    align-self: center;
    max-width: 820px;
    padding-bottom: clamp(18px, 5vh, 54px);
  }

  .maintenance-content h1 {
    max-width: 880px;
    margin-bottom: clamp(18px, 3vh, 30px);
    color: #13382b;
    font-size: clamp(3.15rem, 6.8vw, 6.9rem);
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-shadow: 0 18px 46px rgba(255, 255, 255, 0.42);
  }

  .maintenance-content .lead {
    max-width: 650px;
    margin-bottom: clamp(8px, 1.7vh, 16px);
    font-size: clamp(1.06rem, 1.35vw, 1.28rem);
  }

  .maintenance-note {
    max-width: 560px;
    margin-bottom: clamp(24px, 4.2vh, 40px);
    color: rgba(19, 56, 43, 0.78);
  }

  .maintenance-content .button-secondary {
    border-color: rgba(19, 56, 43, 0.26);
    background: rgba(255, 253, 248, 0.72);
    color: #13382b;
  }

  .maintenance-aside {
    align-self: end;
    justify-self: end;
    width: min(100%, 340px);
    border-left: 3px solid var(--color-gold);
    padding: 18px 0 18px 24px;
  }

  .maintenance-aside p {
    margin: 0 0 8px;
    color: rgba(19, 56, 43, 0.84);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 2vw, 1.8rem);
    line-height: 1.18;
  }

  .maintenance-aside span {
    color: var(--color-gold-dark);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .maintenance-page {
      align-items: start;
    }

    .maintenance-image {
      inset: auto -12% -12% -12%;
      height: 52%;
      opacity: 0.52;
      background-image:
        linear-gradient(180deg, rgba(252, 251, 247, 0.18), rgba(252, 251, 247, 0.78) 72%, rgba(252, 251, 247, 0.96)),
        url("/assets/old-site/hero-header.jpg");
      background-position: 62% center;
    }

    .maintenance-shell {
      align-content: center;
      height: 100dvh;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      gap: clamp(22px, 5vh, 38px);
      padding-top: max(14px, env(safe-area-inset-top));
      padding-bottom: max(14px, env(safe-area-inset-bottom));
    }

    .maintenance-brand {
      align-self: end;
    }

    .maintenance-content {
      align-self: start;
      padding-bottom: 0;
    }

    .maintenance-content h1 {
      max-width: 11.5ch;
      margin-bottom: 12px;
      font-size: clamp(2rem, 10vw, 3rem);
      letter-spacing: -0.02em;
    }

    .maintenance-content .lead {
      margin-bottom: 8px;
      font-size: clamp(0.98rem, 4vw, 1.08rem);
    }

    .maintenance-note {
      margin-bottom: 20px;
    }

    .maintenance-aside {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .maintenance-shell {
      gap: 20px;
    }

    .maintenance-brand img {
      width: 136px;
    }

    .maintenance-content h1 {
      font-size: clamp(1.9rem, 9.8vw, 2.65rem);
      line-height: 1;
    }

    .maintenance-content .lead,
    .maintenance-note {
      line-height: 1.45;
    }
  }

  @media (max-height: 620px) {
    .maintenance-shell {
      gap: 14px;
      padding-top: 14px;
      padding-bottom: 14px;
    }

    .maintenance-content h1 {
      margin-bottom: 10px;
      font-size: clamp(1.85rem, 9vh, 4.2rem);
    }

    .maintenance-content .lead {
      margin-bottom: 6px;
    }

    .maintenance-note {
      margin-bottom: 14px;
    }

    .button {
      min-height: 44px;
      padding-top: 10px;
      padding-bottom: 10px;
    }
  }
</style>
