---
import "../styles/global.css";

const pageTitle = "Sito in manutenzione | La Speziale";
const description =
  "Il sito La Speziale è temporaneamente in manutenzione. Stiamo preparando la nuova versione e torneremo presto online.";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="maintenance-page" aria-labelledby="maintenance-title">
      <div class="maintenance-image" aria-hidden="true"></div>
      <section class="container maintenance-copy">
        <a class="maintenance-brand" href="/manutenzione" aria-label="La Speziale">
          <img
            src="/assets/old-site/logo.png"
            alt="Studio nutrizionista La Speziale Milano"
            width="180"
            height="64"
          />
        </a>

        <div class="maintenance-panel">
          <p class="eyebrow">Sito in manutenzione</p>
          <h1 id="maintenance-title">Stiamo preparando il nuovo sito.</h1>
          <p class="lead">
            La Speziale tornerà online a breve con contenuti aggiornati e una navigazione più chiara.
          </p>
          <p class="maintenance-note">
            Per informazioni o appuntamenti puoi contattarci direttamente.
          </p>

          <div class="button-row" aria-label="Contatti">
            <a class="button button-primary" href="mailto:laspeziale@laspeziale.it">
              Scrivi una email
            </a>
            <a class="button button-secondary" href="tel:+393334063401">
              Chiama lo studio
            </a>
          </div>
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  html {
    height: 100%;
    overflow: hidden;
  }

  body {
    height: 100%;
    overflow: hidden;
  }

  .maintenance-page {
    position: relative;
    display: grid;
    height: 100dvh;
    min-height: 100dvh;
    overflow: hidden;
    align-items: center;
    background: #fbfdfd;
  }

  .maintenance-image {
    position: absolute;
    inset: -3%;
    background-image:
      linear-gradient(90deg, rgba(255, 255, 255, 0.97), rgba(255, 255, 255, 0.84) 37%, rgba(255, 255, 255, 0.38) 66%, rgba(255, 255, 255, 0.08)),
      url("/assets/old-site/hero-header.jpg");
    background-position: 64% center;
    background-size: cover;
    pointer-events: none;
  }

  .maintenance-image::after {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 82% 62%, rgba(120, 151, 124, 0.16), transparent 34%),
      radial-gradient(circle at 20% 6%, rgba(197, 155, 39, 0.1), transparent 24rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(245, 249, 248, 0.42));
    content: "";
  }

  .maintenance-copy {
    position: relative;
    z-index: 1;
    display: grid;
    max-height: 100dvh;
    gap: clamp(24px, 6vh, 54px);
  }

  .maintenance-brand {
    display: inline-flex;
    width: fit-content;
  }

  .maintenance-brand img {
    width: clamp(138px, 17vw, 180px);
    height: auto;
  }

  .maintenance-panel {
    max-width: 690px;
  }

  .maintenance-panel h1 {
    max-width: 780px;
    margin-bottom: clamp(14px, 2.6vh, 24px);
    color: #13382b;
    font-size: clamp(2.05rem, 5vw, 4rem);
    text-shadow: 0 18px 46px rgba(255, 255, 255, 0.42);
  }

  .maintenance-panel .lead {
    max-width: 620px;
    margin-bottom: clamp(8px, 1.8vh, 14px);
  }

  .maintenance-note {
    max-width: 560px;
    margin-bottom: clamp(20px, 4vh, 32px);
    color: rgba(19, 56, 43, 0.78);
  }

  .maintenance-panel .button-secondary {
    border-color: rgba(19, 56, 43, 0.26);
    background: rgba(255, 255, 255, 0.58);
    color: #13382b;
  }

  @media (max-width: 820px) {
    .maintenance-page {
      align-items: start;
    }

    .maintenance-image {
      background-image:
        linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.9) 42%, rgba(255, 255, 255, 0.46) 76%, rgba(255, 255, 255, 0.12) 100%),
        url("/assets/old-site/hero-header.jpg");
      background-position: 65% center;
    }

    .maintenance-copy {
      align-content: center;
      height: 100dvh;
      gap: clamp(18px, 4vh, 34px);
      padding-top: max(14px, env(safe-area-inset-top));
      padding-bottom: max(14px, env(safe-area-inset-bottom));
    }

    .maintenance-panel h1 {
      max-width: 11ch;
      margin-bottom: 12px;
      font-size: clamp(2rem, 10vw, 3rem);
    }

    .maintenance-panel .lead {
      margin-bottom: 8px;
      font-size: clamp(0.98rem, 4vw, 1.08rem);
    }

    .maintenance-note {
      margin-bottom: 20px;
    }
  }

  @media (max-width: 520px) {
    .maintenance-copy {
      gap: 18px;
    }

    .maintenance-brand img {
      width: 136px;
    }

    .maintenance-panel h1 {
      font-size: clamp(1.9rem, 9.8vw, 2.65rem);
      line-height: 1;
    }

    .maintenance-panel .lead,
    .maintenance-note {
      line-height: 1.45;
    }
  }

  @media (max-height: 620px) {
    .maintenance-copy {
      gap: 14px;
    }

    .maintenance-panel h1 {
      margin-bottom: 10px;
      font-size: clamp(1.85rem, 8vh, 3.1rem);
    }

    .maintenance-panel .lead {
      margin-bottom: 6px;
    }

    .maintenance-note {
      margin-bottom: 14px;
    }

    .button {
      min-height: 44px;
      padding-top: 10px;
      padding-bottom: 10px;
    }
  }
</style>
